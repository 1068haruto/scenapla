<% content_for :title do %>Incomes<% end %>

<div class="container">
  <div class="mb-5">
    <h1 class="display-4">Incomes</h1>
    <h4 class="mb-3">現在の月収入と退職ついて教えてください。</h4>
  </div>

  <div class="row d-flex justify-content-center">
    <div class="col-11 border border-dark rounded p-3 mb-4">
      <%= form_with model: @income, url: incomes_path, local: true, id: "income-form" do |f| %>
        <div class="row">
          <div class="col-md">
            <%= f.label :person_type, '対象', class: 'form-label' %>
            <%= f.select :person_type, Income.person_types.keys.map { |type| [type, type] }, {}, class: 'form-select', autofocus: true %>
          </div>

          <div class="col-md">
            <%= f.label :income, '月収（手取り）', class: 'form-label' %>
            <div class="input-group">
              <%= f.number_field :income, class: 'form-control', step: 0.1 %>
              <span class="input-group-text">万円</span>
            </div>
          </div>

          <div class="col-md">
            <%= f.label :retirement_date, '退職時期', class: 'form-label' %>
            <div class="input-group">
              <%=
                f.select :retirement_date,
                options_for_select((Date.today.year..(Date.today.year + 50)).map { |year| [year, year] }), {},
                class: 'form-select'
              %>
              <span class="input-group-text">年</span>
            </div>  
          </div>

          <div class="col-md">
            <%= f.label :retirement_pay, '退職金（手取り）', class: 'form-label' %>
            <div class="input-group">
              <%= f.number_field :retirement_pay, class: 'form-control', step: 0.1 %>
              <span class="input-group-text">万円</span>
            </div>
          </div>
        </div>

        <div class="mt-3 d-flex justify-content-center">
          <%= f.submit '追加', class: 'btn btn-outline-primary' %>
        </div>
      <% end %>
    </div>

    <div class="col-11 mb-4">
      <h5>追加した収入データ</h5>
      <% if @incomes.any? %>
        <div class="accordion" id="incomesAccordion">
          <% @incomes.each_with_index do |income, index| %>
            <%=
              render 'income', 
              income: income,
              index: index,
              accordion_id: "incomesAccordion",
              show_delete_button: true
            %>
          <% end %>
        </div>
      <% else %>
        <p class="text-secondary">&nbsp;&nbsp;データがありません。</p>
      <% end %>
    </div>
  </div>

  <div class="d-flex justify-content-center">
    <%= link_to 'ホームに戻る', dashboard_path, class: 'btn btn-outline-secondary me-2', data: { turbo: true } %>
    <% if @incomes.any? %>
      <%=
        button_to '保存して次へ', update_simulation_data_incomes_path(simulation_id: current_user.simulation.id),
        method: :post, class: 'btn btn-primary', data: { turbo: true }
      %>
    <% end %>
  </div>
</div>
