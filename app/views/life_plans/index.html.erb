<% content_for :title do %>LifePlan<% end %>
<% @vm = @view_model %>

<div class="container">
  <%= render 'shared/page_hd', title: 'LifePlan',
    subtitle: 'プランの具体化',
    description: '今後の計画や目標などをメモに整理しましょう。'
  %>

  <%= render "ai_advice",
    advice: @vm.advice_content,
    remaining_advice_count: @vm.remaining_advice_count
  %>

  <% @vm.age_groups.each do |age_group| %>
    <div class="card mb-3">
      <div class="card-header">
        <h3 class="mt-2"><%= age_group %>代</h3>
      </div>

      <div class="card-body">
        <div class="row">
          <div class="col-md-5">
            <% if @vm.has_life_events?(age_group) %>
              <div class="accordion" id="lifeEventsAcc-<%= age_group %>">
                <% @vm.life_events_for_age_group(age_group).each_with_index do |life_event, index| %>
                  <%= render 'shared/acc_item',
                    model: life_event,
                    acc_id: "lifeEventsAcc",
                    index: index,
                    badge_text: life_event.event_type,
                    badge_class: (life_event.event_type == '理想' ? 'bg-success' : 'bg-primary'),
                    extra_title: "#{life_event.event_date.year}年 #{life_event.title}",
                    edit_path: edit_life_event_path(life_event),
                    delete_path: life_event_path(life_event) do %>
                    <li><strong>年額:</strong> <%= life_event.amount %>万円</li>
                    <li><strong>支払期間:</strong> <%= life_event.payment_period %>年間</li>
                  <% end %>
                <% end %>
              </div>
            <% else %>
              <p>ライフイベント未登録</p>
            <% end %>
          </div>

          <div class="col mt-2 mt-md-0">
            <%= render "memo", memo_instance: @vm.memo_instance_for_age_group(age_group) %>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <div class="d-flex justify-content-center">
    <% if @vm.show_next_button? %>
      <%= next_button_get('情報入力画面へ', incomes_path) %>
    <% else %>
      <%= back_button('ライフイベント編集', life_events_path) %>
    <% end %>
  </div>
</div>
