<% content_for :title do %>date_of_birth<% end %>

<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-10 col-md-8 col-lg-5 border border-dark p-3 rounded">
      <h5 class="card-title mb-4 text-center">始めるには生年月日を登録して下さい。</h5>

      <%= form_with model: current_user, url: update_date_of_birth_path, method: :patch, local: true do |f| %>
        <%= render "devise/shared/error_messages", resource: @resource %>

        <div class="form-floating mb-3">
          <%= f.date_field :date_of_birth, class: 'form-control', id: 'floatingBirthday', placeholder: 'YYYY-MM-DD', pattern: '\d{4}-\d{2}-\d{2}' %>
          <%= f.label :date_of_birth, '生年月日', class: 'form-label', for: 'floatingBirthday' %>
        </div>

        <div class="actions text-center">
          <%= f.submit '登録', class: 'btn btn-outline-primary' %>
        </div>
      <% end %>
    </div>
  </div>
</div>
