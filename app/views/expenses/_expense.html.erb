<% if expense.persisted? %>
  <tr>
    <td class="pt-2"><%= expense.housing_expense %>万円</td>
    <td class="pt-2">
      <% if expense.repayment_date.present? %>
        <%= expense.repayment_date.year %>年
      <% else %>
        支払なし
      <% end %>
    </td>
    <td class="pt-2"><%= expense.living_expenses %>万円</td>
    <td class="pt-2"><%= expense.monthly_premiums %>万円</td>
    <td class="pt-2"><%= expense.other_expenses %>万円</td>
  </tr>
<% end %>
