<%= form_with model: expense, local: true do |f| %>
  <div class="row d-flex justify-content-center">
    <div class="col-md-4 col-lg-3 col-xl-3">
      <%= f.label :housing_expenses, '住居費（家賃orローン）', class: 'form-label' %>
      <div class="input-group">
        <%= f.number_field :housing_expenses, class: 'form-control', step: 0.1, required: true, autofocus: true %>
        <span class="input-group-text">万円</span>
      </div>
    </div>

    <div class="col-md-4 col-lg-3 col-xl-3">
      <%= f.label :repayment_date, '住宅ローン完済時期', class: 'form-label' %>
      <div class="input-group">
        <%= f.select :repayment_date,
          options_for_select(
            [['支払なし', nil]] + (Date.today.year..(Date.today.year + 50)).map { |year| [year, year] },
            expense.repayment_date&.year
          ),{},
          class: 'form-select'
        %>
        <span class="input-group-text">年</span>
      </div>
    </div>

    <div class="col-md-4 col-lg-3 col-xl-2">
      <%= f.label :living_expenses, '生活費', class: 'form-label' %>
      <div class="input-group">
        <%= f.number_field :living_expenses, class: 'form-control', step: 0.1, required: true %>
        <span class="input-group-text">万円</span>
      </div>
    </div>

    <div class="col-md-4 col-lg-3 col-xl-2">
      <%= f.label :monthly_premiums, '保険費（貯蓄型除く）', class: 'form-label' %>
      <div class="input-group">
        <%= f.number_field :monthly_premiums, class: 'form-control', step: 0.1, required: true %>
        <span class="input-group-text">万円</span>
      </div>
    </div>

    <div class="col-md-4 col-lg-3 col-xl-2">
      <%= f.label :other_expenses, 'その他費用', class: 'form-label' %>
      <div class="input-group">
        <%= f.number_field :other_expenses, class: 'form-control', step: 0.1, required: true %>
        <span class="input-group-text">万円</span>
      </div>
    </div>
  </div>

  <div class="mt-3 d-flex justify-content-center">
    <%= f.submit expense.persisted? ? '更新' : '追加', class: 'btn btn-outline-primary me-2' %>
    <% if expense.persisted? %>
      <%= link_to 'キャンセル', expenses_path, class: 'btn btn-outline-secondary' %>
    <% end %>
  </div>
<% end %>
