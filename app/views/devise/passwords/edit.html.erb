<div class="container">
  <% content_for :title do %>Password reset<% end %>
  <div class="mb-5 text-center">
    <h1 class="display-4">Password reset</h1>
  </div>

  <div class="row justify-content-center">
    <div class="col-md-6">
      <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>
        <%= f.hidden_field :reset_password_token %>

        <div class="mb-3">
          <%= f.label :password, '新しいパスワード', class: 'form-label' %>
          <% if @minimum_password_length %>
            <em>※半角英数<%= @minimum_password_length %>文字以上</em>
          <% end %>
          <%= f.password_field :password, autofocus: true, autocomplete: "new-password",  class: 'form-control' %>
        </div>

        <div class="mb-3">
          <%= f.label :password_confirmation, '新しいパスワード（確認用）', class: 'form-label' %>
          <%= f.password_field :password_confirmation, autocomplete: "new-password", class: 'form-control' %>
        </div>

        <div class="actions text-center">
          <%= f.submit "パスワード変更", class: 'btn btn-primary' %>
        </div>
      <% end %>
    </div>
  </div>
</div>

<div class="mb-4"></div>
  <%= render "devise/shared/links" %>
</div>
