<h1>Expenses</h1>

<%= form_with model: @expense, url: create_or_update_expenses_path, method: :post, local: true, id: "expense-form" do |f| %>
  <div class="form-group">
    <%= f.label :housing_expense, '住居費（月額）※家賃またはローン', class: 'form-label' %>
    <%= f.number_field :housing_expense, class: 'form-control', required: true %>
  </div>
  <div class="form-group">
    <%= f.label :repayment_date, '住宅ローン完済時期', class: 'form-label' %>
    <%= f.select :repayment_date, options_for_select([['支払いなし', nil]] + (Date.today.year..(Date.today.year + 50)).map { |year| [year, year] }), {}, class: 'form-select' %>
  </div>
  <div class="form-group">
    <%= f.label :living_expenses, '生活費（月額）', class: 'form-label' %>
    <%= f.number_field :living_expenses, class: 'form-control', required: true %>
  </div>
  <div class="form-group">
    <%= f.label :monthly_premiums, '保険費（月額）※貯蓄型保険は除く', class: 'form-label' %>
    <%= f.number_field :monthly_premiums, class: 'form-control', required: true %>
  </div>
  <div class="form-group">
    <%= f.label :other_expenses, 'その他費用（月額）', class: 'form-label' %>
    <%= f.number_field :other_expenses, class: 'form-control' %>
  </div>
  <div class="form-group">
    <%= f.submit '追加', class: 'btn btn-primary' %>
  </div>
<% end %>
<%= link_to '収入入力に戻る', incomes_path, class: 'btn btn-secondary', data: { turbo: true } %>

<div id="expenses">
  <% if @last_expense %>
    <%= render @last_expense %>
  <% else %>
    <p>No expense data available.</p>
  <% end %>
</div>

<% if @last_expense %>
  <%= button_to '保存して次へ', update_simulation_data_expense_path(@last_expense), method: :post, class: 'btn btn-primary' %>
<% end %>
