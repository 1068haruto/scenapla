<% content_for :title do %>Scenarios<% end %>

<div class="container">
  <div class="mt-3 mb-5 text-center">
    <h1 class="display-4">Scenarios</h1>
    <h4 class="mb-3">シミュレーション結果</h4>
    # todo: helper, turbo
    <%= button_to '表示 / 更新',
      update_scenarios_lifespan_scenarios_path,
      method: :post, class: 'btn btn-outline-primary mb-3'
    %>
  </div>

  <!-- 資産寿命シナリオ -->
  <div class="card mb-4">
    <div class="card-header d-flex align-items-center">
      <h4 class="mt-2">資産寿命シナリオ</h4>
      <% if show_asset_lifespan_scenario?(@asset_lifespan) %>
        <span class="ms-auto"><%= formatted_date(@asset_lifespan_updated_at) %>時点</span>
      <% end %>
    </div>

    <div class="card-body">
      <% if show_asset_lifespan_scenario?(@asset_lifespan) %>
        <p>
          現在の生活水準の場合、資産寿命は
          <strong><%= @lifespan_years %>年<%= @lifespan_months %>ヶ月</strong> です。
        </p>
        <%= lifespan_chart(@lifespan_chart_data) %>
      <% else %>
        <p>支出または資産情報が未登録ため、表示できません。</p>
      <% end %>
    </div>
  </div>

  <!-- 現実的シナリオ -->
  <div class="card mb-4">
    <%= render 'balance_scenario_card',
      title: "現実的シナリオ",
      updated_at: @real_updated_at,
      balance_chart_data: @real_balance_chart_data,
      total_income: @real_total_income,
      total_expense: @real_total_expense,
      total_balance: @real_total_balance,
      withdrawal: @real_withdrawal,
      shortage: @real_shortage
    %>
  </div>

  <!-- 理想的シナリオ -->
  <div class="card mb-4">
    <%= render 'balance_scenario_card',
      title: "理想的シナリオ",
      updated_at: @ideal_updated_at,
      balance_chart_data: @ideal_balance_chart_data,
      total_income: @ideal_total_income,
      total_expense: @ideal_total_expense,
      total_balance: @ideal_total_balance,
      withdrawal: @ideal_withdrawal,
      shortage: @ideal_shortage
    %>
  </div>

  <!-- 資産運用シナリオ -->
  <div class="card mb-4">
    <div class="card-header d-flex align-items-center">
      <h4 class="mt-2">資産運用シナリオ</h4>
      <% if show_asset_scenario?(@asset_data, @user_assets) %>
        <span class="ms-auto">
          <%= formatted_date(@user_asset_data_updated_at) %>時点
        </span>
      <% end %>
    </div>

    <div class="card-body">
      <% if show_asset_scenario?(@asset_data, @user_assets) %>
        <p>現在の資産を運用した場合の今後の推移です。</p>
        <%= asset_chart(@asset_data) %>
      <% else %>
        <p>資産情報が未登録のため、表示できません。</p>
      <% end %>
    </div>
  </div>

  <% if show_next_button?(@simulation) %>
    <p class="mb-5 text-muted">
      ※ 各シナリオは、特定の前提条件に基づいて算出した概算値であり、
      市場の動向や個々の状況変化により、実際の数値とは異なる場合があります。<br>
      &nbsp;&nbsp;&nbsp;将来を保証するものではなく、意思決定の補助としてご利用ください。
    </p>
  <% end %>

  <div class="d-flex justify-content-center">
    <% if show_next_button?(@simulation) %>
      <%= back_button('条件を変えて再入力', incomes_path) %>
      <%= next_button_get('ライフプランへ', life_plans_path) %>
    <% else %>
      <%= next_button_get('情報入力画面へ', incomes_path) %>
    <% end %>
  </div>
</div>
