<%= form_with model: income, local: true do |f| %>
  <%= render layout: 'shared/form_wrapper', locals: { f: f, model: income, back_path: incomes_path } do %>

    <%= render layout: 'shared/form_row', locals: { f: f, field: :person_type, label_text: '対象者' } do %>
      <%= f.select :person_type, Income.person_types.keys.map { |type| [type, type] }, {}, class: 'form-select', autofocus: true %>
    <% end %>

    <%= render layout: 'shared/form_row', locals: { f: f, field: :monthly_income, label_text: '月収（手取り）', unit: '万円' } do %>
      <%= f.number_field :monthly_income, class: 'form-control', step: 0.1, required: true %>
    <% end %>

    <%= render layout: 'shared/form_row', locals: { f: f, field: :yearly_bonus, label_text: '賞与年額（手取り）', unit: '万円' } do %>
      <%= f.number_field :yearly_bonus, class: 'form-control', step: 0.1, required: true %>
    <% end %>

    <%= render layout: 'shared/form_row', locals: { f: f, field: :retirement_date, label_text: '退職時期', unit: '年' } do %>
      <%= f.select :retirement_date, options_for_select((Date.today.year..(Date.today.year + 50)).map { |year| [year, year] }, income.retirement_date&.year), {}, class: 'form-select' %>
    <% end %>

    <%= render layout: 'shared/form_row', locals: { f: f, field: :retirement_pay, label_text: '退職金（手取り）', unit: '万円', last: true } do %>
      <%= f.number_field :retirement_pay, class: 'form-control', step: 0.1, required: true %>
    <% end %>

  <% end %>
<% end %>