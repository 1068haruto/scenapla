<% content_for :title do %>Scenarios<% end %>

<div class="container">
  <div class="mb-5">
    <h1 class="display-4">Scenarios</h1>
    <h4 class="mb-3">シミュレーション結果</h4>
    <%= button_to '表示 / 更新', update_scenarios_scenarios_path, method: :post, class: 'btn btn-primary mb-3' %>
  </div>

  <div class="card mb-4">
    <div class="card-body">
      <h4>資産寿命</h4>
      <% if @asset_lifespan && @asset_lifespan.yearly_lifespans.present? %>
        <div class="mb-4">
          <span class="mb-4"><%= formatted_date(@asset_lifespan_updated_at) %>時点</span>
        </div>
        <% if @lifespan_years && @lifespan_months %>
          <p>現時点のあなたの資産寿命は、<strong><%= @lifespan_years %>年<%= @lifespan_months %>ヶ月</strong> です。（現在の生活水準の場合）</p>
          <p>資産を瞬間的に捉え、時間換算をすることで本質的な豊かさ表しています。</p>
        <% else %>
          <p>資産情報が登録されていません。</p>
        <% end %>
        <%= column_chart @lifespan_chart_data, xtitle: '年', ytitle: '資産額（万円）' %>
      <% else %>
        <p>資産情報の登録がないため、グラフを表示できません。</p>
      <% end %>
    </div>
  </div>

  <div class="card mb-4">
    <div class="card-body">
      <h4>現実的シナリオ</h4>
        <% if @simulation.user_asset_data.nil? || @simulation.user_asset_data.empty? %>
          <p>情報入力が完了していないため、現実的シナリオを表示できません。</p>
        <% else %>
          <div class="mb-4">
            <span><%= formatted_date(@real_updated_at) %>時点</span>
          </div>
          <div class="row mb-3">
            <div class="col text-center">
              <div class="card border-danger mb-2">
                <div class="card-body">
                  <p class="card-text">トータル収入：<%= @real_total_income %>万円</p>
                </div>
              </div>
            </div>
            <div class="col text-center">
              <div class="card border-info mb-2">
                <div class="card-body">
                  <p class="card-text">トータル支出：<%= @real_total_expense %>万円</p>
                </div>
              </div>
            </div>
            <div class="col text-center">
              <div class="card border-success mb-2">
                <div class="card-body">
                  <p class="card-text">トータル収支：<%= @real_total_balance %>万円</p>
                </div>
              </div>
            </div>
          </div>
          <% if @real_withdrawal == 0 %>
            <p>70歳以降：マイナス収支の為、運用資産以外から得られるプラス資産はありません。</p>
            <p>現状の収入や支出、今後のライフイベントやキャリアパスの見直しをおすすめします。</p>
          <% else %>
            <p>70歳以降：<%= @real_withdrawal %>ヶ月目まで運用資産を取り崩さず、70歳までに積み上げたプラス収支で生活できます。</p>
          <% end %>
          <% if @real_shortage == 0 %>
            <p>70歳時点ではプラスですが、それまでにマイナスの年がある場合は、運用資産の取り崩しや収支の改善等でマイナスを補填する必要があります。</p>
          <% else %>
            <p>70歳時点のトータル収支を基準とすると、現時点で最低でも<strong>年額<%= @real_shortage %>万円</strong>が不足しています。</p>
            <p>70歳までにマイナスの年がある場合は、上記不足額以上の金額がその年までに必要となります。</p>
          <% end %>
          <%= area_chart @real_balance_chart_data, height: "300px", download: {filename: "現実的シナリオ"}, dataset: {borderWidth: 1}, xtitle: '年', ytitle: '収支額（万円）' %> 
        <% end %>
    </div>
  </div>

  <div class="card mb-4">
    <div class="card-body">
      <h4>理想的シナリオ</h4>
      <% if @ideal_balance_chart_data.empty? %>
        <p>理想ライフイベントの登録がないため、理想的シナリオを表示できません。</p>
      <% else %>
        <div class="mb-4">
          <span><%= formatted_date(@ideal_updated_at) %>時点</span>
        </div>
        <div class="row mb-3">
          <div class="col text-center">
            <div class="card border-danger mb-2">
              <div class="card-body">
                <p class="card-text">トータル収入：<%= @ideal_total_income %>万円</p>
              </div>
            </div>
          </div>
          <div class="col text-center">
            <div class="card border-info mb-2">
              <div class="card-body">
                <p class="card-text">トータル支出：<%=  @ideal_total_expense %>万円</p>
              </div>
            </div>
          </div>
          <div class="col text-center">
            <div class="card border-success mb-2">
              <div class="card-body">
                <p class="card-text">トータル収支：<%=  @ideal_total_balance %>万円</p>
              </div>
            </div>
          </div>
        </div>
        <% if  @ideal_withdrawal == 0 %>
          <p>70歳以降：マイナス収支の為、運用資産以外から得られるプラス資産はありません。</p>
          <p>現状の収入や支出、今後のライフイベントやキャリアパスの見直しをおすすめします。</p>
        <% else %>
          <p>70歳以降：<strong><%= @ideal_withdrawal %>ヶ月目</strong>まで運用資産を取り崩さず、70歳までに積み上げたプラス収支で生活できます。</p>
        <% end %>
        <% if @ideal_shortage == 0 %>
          <p>70歳時点ではプラスですが、それまでにマイナスの年がある場合は、運用資産の取り崩しや収支の改善等でマイナスを補填する必要があります。</p>
        <% else %>
          <p>70歳時点のトータル収支を基準とすると、現時点で最低でも<strong>年額<%= @ideal_shortage %>万円</strong>が不足しています。</p>
          <p>70歳までにマイナスの年がある場合は、上記不足額以上の金額がその年までに必要となります。</p>
        <% end %>
        <%= area_chart  @ideal_balance_chart_data, height: "300px", download: {filename: "理想的シナリオ"}, dataset: {borderWidth: 1}, xtitle: '年', ytitle: '収支額（万円）' %> 
      <% end %>
    </div>
  </div>

  <div class="card mb-4">
    <div class="card-body">
      <h4>運用資産シナリオ</h4>
      <% if @asset_data.empty? %>
        <p>資産の登録がないため、運用資産シナリオを表示できません。</p>
      <% else %>
        <div class="mb-4">
          <span><%= formatted_date(@user_asset_data_updated_at) %>時点</span>
        </div>
        <p>現時点の資産情報を元にした今後の推移です。積立や取り崩しなどを行う場合、資産情報を更新する必要があります。</p>
        <%= area_chart @asset_data, height: "300px", colors: ["#FF5733"], download: {filename: "運用資産シナリオ"}, xtitle: '年', ytitle: '運用資産額（万円）' %>
      <% end %>
    </div>
  </div>

  <div class="d-flex justify-content-center">
    <% if @simulation.user_asset_data.nil? || @simulation.user_asset_data.empty? %>
      <%= link_to '情報入力画面へ', incomes_path, class: 'btn btn-primary me-2', data: { turbo_method: :get } %>
    <% else %>
      <%= link_to '条件を変えて再入力', incomes_path, class: 'btn btn-secondary me-2', data: { turbo: true } %>
      <%= link_to 'ライフプランへ', life_events_path, class: 'btn btn-primary me-2', data: { turbo: true } %>
    <% end %>
  </div>
</div>
