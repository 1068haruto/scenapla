<div id="<%= dom_id(user_asset) %>" class="row">
  <p class="col">対象者：<%= user_asset.person_type %></p>
  <p class="col">資産種類：<%= user_asset.asset_type %></p>
  <p class="col">総額：<%= user_asset.amount %>万円</p>
  <p class="col">利回り：<%= user_asset.return_rate %>%</p>
  <p class="col">
    <%= link_to '削除', user_asset_path(user_asset), data: { turbo_method: :delete }, class: 'btn btn-danger'%>
  </p>
</div>
