<% content_for :title do %>Assets<% end %>

<div class="container">
  <div class="mt-3 mb-5 text-center">
    <h1 class="display-4">Assets</h1>
    <h4 class="mb-3">現在の資産について教えて下さい</h4>
  </div>

  <div class="row d-flex justify-content-center">
    <div class="col-11 border border-dark rounded p-3 mb-4">
      <%= form_with model: @user_asset, id: "user-asset-form" do |f| %>
        <div class="row">
          <div class="col-md">
            <%= f.label :person_type, '対象者', class: 'form-label' %>
            <%=
              f.select :person_type,
              @user_asset.class.person_types.keys.map { |key| [key.humanize, key] },
              {},
              class: "form-select",
              autofocus: true
            %>
          </div>

          <div class="col-md">
            <%= f.label :asset_type, '資産種類', class: 'form-label' %>
            <%= f.select :asset_type, @user_asset.class.asset_types.keys.map { |key| [key.humanize, key] }, {}, class: "form-select" %>
          </div>

          <div class="col-md">
            <%= f.label :amount, '総額', class: 'form-label' %>
            <div class="input-group">
              <%= f.number_field :amount, class: "form-control", step: 0.1, required: true %>
              <span class="input-group-text">万円</span>
            </div>
          </div>

          <div class="col-md">
            <%= f.label :return_rate, '利回り', class: 'form-label' %>
            <div class="input-group">
              <%= f.number_field :return_rate, class: "form-control", step: 0.1, required: true  %>
              <span class="input-group-text">%</span>
            </div>
          </div>
        </div>

        <div class="mt-3 d-flex justify-content-center">
          <%= f.submit '追加', class: 'btn btn-outline-primary' %>
        </div>
      <% end %>
    </div>

    <div class="col-11 mb-4">
      <h5>追加した資産データ</h5>
      <% if @user_assets.any? %>
        <div class="accordion" id="userAssetsAccordion">
          <% @user_assets.each_with_index do |user_asset, index| %>
            <%=
              render 'user_asset', 
              user_asset: user_asset,
              index: index,
              accordion_id: "userAssetsAccordion",
              show_delete_button: true
            %>
          <% end %>
        </div>
      <% else %>
        <p class="text-secondary">&nbsp;&nbsp;データがありません。</p>
      <% end %>
    </div>
  </div>

  <div class="d-flex justify-content-center">
    <%= link_to '支出に戻る', expenses_path, class: 'btn btn-outline-secondary me-2', data: { turbo: true } %>
    <% if @user_assets.any? %>
      <%= button_to '保存して次へ', update_user_asset_data_simulation_path, class: 'btn btn-primary', method: :post, data: { turbo: true } %>
    <% end %>
  </div>
</div>
