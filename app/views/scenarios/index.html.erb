<% content_for :title do %>Scenarios<% end %>

<div class="container">
  <%= render 'shared/page_hd', title: 'Scenarios', subtitle: 'シミュレーション結果' do %>
    <%= button_to '表示 / 更新', update_scenarios_lifespan_scenarios_path, method: :post, class: 'btn btn-outline-primary mb-3' %>
  <% end %>

  <% vm = @view_model.asset_lifespan_vm %>
  <%= render layout: 'scenario_card', locals: { title: "資産寿命シナリオ", vm: vm } do %>
    <p>資産寿命：<strong><%= vm.lifespan_years %>年<%= vm.lifespan_months %>ヶ月</strong></p>
    <%= lifespan_chart(vm.lifespan_chart_data) %>
  <% end %>

  <% vm = @view_model.real_scenario_vm %>
  <%= render layout: 'scenario_card', locals: { title: "現実的シナリオ", vm: vm } do %>
    <%= render 'balance_content', vm: vm %>
  <% end %>

  <% vm = @view_model.ideal_scenario_vm %>
  <%= render layout: 'scenario_card', locals: { title: "理想的シナリオ", vm: vm } do %>
    <%= render 'balance_content', vm: vm %>
  <% end %>

  <% vm = @view_model.asset_scenario_vm %>
  <%= render layout: 'scenario_card', locals: { title: "資産運用シナリオ", vm: vm } do %>
    <p class="text-muted">現在資産を基にした推移</p>
    <%= asset_chart(vm.asset_data) %>
  <% end %>

  <!-- 注釈 -->
  <% if @view_model.show_next_button? %>
    <p class="mb-5 text-muted">
      ※ 各シナリオは、特定の前提条件に基づいて算出した概算値であり、
      市場の動向や個々の状況変化により、実際の数値とは異なる場合があります。<br>
      &nbsp;&nbsp;&nbsp;将来を保証するものではなく、意思決定の補助としてご利用ください。
    </p>
  <% end %>

  <div class="d-flex justify-content-center">
    <% if @view_model.show_next_button? %>
      <%= back_button('条件を変えて再入力', incomes_path) %>
      <%= next_button_get('ライフプランへ', life_plans_path) %>
    <% else %>
      <%= next_button_get('情報入力画面へ', incomes_path) %>
    <% end %>
  </div>
</div>
