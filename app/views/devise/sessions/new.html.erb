<div class="container">
  <% content_for :title do %>Login<% end %>
  <div class="mb-4 text-center">
    <h1 class="display-4">Login</h1>
  </div>

  <div class="row justify-content-center">
    <div class="col-10 col-md-4 border border-dark p-3 rounded bg-light">
      <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>

        <div class="form-floating mb-3">
          <%= f.email_field :email, class: 'form-control', id: 'floatingInput', placeholder: 'name@example.com', autofocus: true, autocomplete: 'email' %>
          <%= f.label :email, 'メールアドレス', class: 'form-label', for: 'floatingInput' %>
        </div>

        <div class="form-floating mb-3">
          <%= f.password_field :password, class: 'form-control', id: 'floatingPassword', placeholder: 'Password', autocomplete: "current-password" %>
          <%= f.label :password, 'パスワード', class: 'form-label', for: 'floatingPassword' %>
        </div>

        <% if devise_mapping.rememberable? %>
          <div class="form-check mb-3">
            <%= f.check_box :remember_me, class: 'form-check-input' %>
            <%= f.label :remember_me, 'ログイン状態を保持する', class: 'form-check-label' %>
          </div>
        <% end %>

        <div class="actions text-center mb-3">
          <%= f.submit "ログイン", class: 'btn btn-outline-primary' %>
        </div>
      <% end %>

      <%= render "devise/shared/links" %>
    </div>
  </div>

  <div class="row justify-content-center mt-3">
    <div class="col-10 col-md-4 border border-dark p-3 rounded d-flex justify-content-center align-items-center bg-light flex-nowrap">
      <p class="mb-0 me-2"><strong>初めての方はこちら</strong></p>
      <%= link_to 'アカウント登録', new_user_registration_path, class: 'btn btn-outline-success', data: { turbo: true } %>
    </div>
  </div>
</div>
