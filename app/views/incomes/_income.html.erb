<% if income.persisted? %>
  <div class="row mb-2 border rounded p-2">
    <p class="col-md-2"><strong>対象者：</strong> <%= income.person_type %></p>
    <p class="col-md-2"><strong>月収（手取り）：</strong> <%= income.income %>万円</p>
    <p class="col-md-2"><strong>退職時期：</strong> <%= income.retirement_date.year %></p>
    <p class="col-md-2"><strong>退職金：</strong> <%= income.retirement_pay %>万円</p>
    <p class="col-md-2">
      <%= link_to '削除', income_path(income), data: { turbo_method: :delete }, class: 'btn btn-danger' %>
    </p>
  </div>
<% end %>