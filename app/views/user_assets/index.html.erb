<% content_for :title do %>Assets<% end %>

<div class="container">
  <div class="mt-3 mb-5 text-center">
    <h1 class="display-4">Assets</h1>
    <h4 class="mb-3">現在の資産について教えて下さい</h4>
  </div>

  <div class="row d-flex justify-content-center">
    <div class="col-11 border border-dark rounded p-3 mb-4">
      <%= render 'user_asset_form', user_asset: @user_asset %>
    </div>

    <div class="col-11 mb-4">
      <h5>追加した資産データ</h5>
      <% if @user_assets.any? %>
        <div class="accordion" id="userAssetsAccordion">
          <% @user_assets.each_with_index do |user_asset, index| %>
            <%= render 'registered_user_asset', user_asset: user_asset, index: index, accordion_id: "userAssetsAccordion" %>
          <% end %>
        </div>
      <% else %>
        <p class="text-secondary">&nbsp;&nbsp;データがありません。</p>
      <% end %>
    </div>
  </div>

  <div class="d-flex justify-content-center">
    <%= back_button('戻る', expenses_path) %>
    <% if @user_assets.any? %>
      <%= next_button_post('保存して次へ', update_user_asset_data_simulation_path) %>
    <% end %>
  </div>
</div>
