<%
  # 必要な変数:
  # model, acc_id, index(任意), title,
  # badge_text, badge_class, edit_path, delete_path
%>

<% index ||= 0 %>
<% show_buttons = local_assigns.fetch(:show_buttons, true) %>

<div class="accordion-item">
  <h2 class="accordion-header" id="heading-<%= acc_id %>-<%= index %>">
    <button class="accordion-button collapsed"
      type="button"
      data-bs-toggle="collapse"
      data-bs-target="#collapse-<%= acc_id %>-<%= index %>"
      aria-expanded="false"
      aria-controls="collapse-<%= acc_id %>-<%= index %>"
    >
      <span class="badge rounded-pill <%= badge_class %>">
        <%= badge_text %>
      </span>
      <% if local_assigns[:extra_title] %>
        <span class="ms-2"><%= extra_title %></span>
      <% end %>
    </button>
  </h2>

  <div class="accordion-collapse collapse"
    id="collapse-<%= acc_id %>-<%= index %>"
    aria-labelledby="heading-<%= acc_id %>-<%= index %>"
    data-bs-parent="#<%= acc_id %>"
  >
    <div class="accordion-body">
      <ul class="list-unstyled">
        <%# 各モデル固有の <li> が入る %>
        <%= yield %>
      </ul>

      <% if show_buttons && model.persisted? %>
        <div class="mt-2">
          <%= edit_button_sm(url_for([:edit, model])) %>
          <%= delete_button(url_for(model)) %>
        </div>
      <% end %>
    </div>
  </div>
</div>
