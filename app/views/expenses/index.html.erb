<%= render layout: 'shared/input_index_layout', locals: {
  title: 'Expenses',
  subtitle: '現在の月支出について教えて下さい',
  description: '',
  form_content: render('expense_form', expense: @expense),
  list_title: '追加した支出データ',
  list_subtitle: '※再追加でデータが上書きされます',
  collection: @latest_expense,
  acc_id: 'expensesAcc',
  back_path: incomes_path,
  next_path: update_expense_data_simulation_path
} do |expense, index| %>
  <%= render 'shared/acc_item',
    model: expense,
    acc_id: "expensesAcc",
    index: index,
    badge_text: "現在の支出",
    badge_class: "bg-primary" do
  %>
    <table class="table table-sm table-borderless mb-0">
      <tbody>
        <tr>
          <th class="fw-bold text-secondary">住居費</th>
          <td><%= expense.housing_expenses %>万円</td>
        </tr>
        <tr>
          <th class="fw-bold text-secondary">ローン完済時期</th>
          <td><%= expense.repayment_date&.year ? "#{expense.repayment_date.year}年" : '支払いなし' %></td>
        </tr>
        <tr>
          <th class="fw-bold text-secondary">生活費</th>
          <td><%= expense.living_expenses %>万円</td>
        </tr>
        <tr>
          <th class="fw-bold text-secondary">保険費（貯蓄型除く）</th>
          <td><%= expense.monthly_premiums %>万円</td>
        </tr>
        <tr>
          <th class="fw-bold text-secondary">その他費用</th>
          <td><%= expense.other_expenses %>万円</td>
        </tr>
      </tbody>
    </table>
  <% end %>
<% end %>
