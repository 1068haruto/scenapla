<%= form_with model: user_asset, local: true do |f| %>
  <div class="row align-items-center justify-content-center">

    <%# 入力フォーム群 %>
    <div class="col-md-9 border border-gray rounded p-4">
      <div class="mb-3 row">
        <%= f.label :person_type, '対象者', class: 'col-sm-4 col-form-label' %>
        <div class="col-sm-8">
          <%= f.select :person_type, @user_asset.class.person_types.keys.map { |key| [key.humanize, key] }, {}, class: "form-select", autofocus: true %>
        </div>
      </div>

      <div class="mb-3 row">
        <%= f.label :asset_type, '資産種類', class: 'col-sm-4 col-form-label' %>
        <div class="col-sm-8">
          <%= f.select :asset_type, @user_asset.class.asset_types.keys.map { |key| [key.humanize, key] }, {}, class: "form-select" %>
        </div>
      </div>

      <div class="mb-3 row">
        <%= f.label :amount, '総額', class: 'col-sm-4 col-form-label' %>
        <div class="col-sm-8">
          <div class="input-group">
            <%= f.number_field :amount, class: "form-control", step: 0.1, required: true %>
            <span class="input-group-text">万円</span>
          </div>
        </div>
      </div>

      <div class="mb-3 row">
        <%= f.label :return_rate, '利回り', class: 'col-sm-4 col-form-label' %>
        <div class="col-sm-8">
          <div class="input-group">
            <%= f.number_field :return_rate, class: "form-control", step: 0.1, required: true %>
            <span class="input-group-text">%</span>
          </div>
        </div>
      </div>
    </div>

    <%# ボタン表示エリア %>
    <div class="col-md-3 text-center">
      <div class="d-grid gap-2 ps-2">
        <%= submit_or_add_button(f, user_asset) %>
        <% if user_asset.persisted? %>
          <%= cancel_button(user_assets_path) %>
        <% end %>
      </div>
    </div>

  </div>
<% end %>
