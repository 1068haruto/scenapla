<% content_for :title do %>News<% end %>

<div class="container mt-5">
  <div class="mb-5 text-center">
    <h1 class="display-4">News</h1>
    <h4 class="mb-3">経済動向をチェック</h4>
  </div>

  <% if flash[:alert].present? %>
    <div class="alert alert-danger"><%= flash[:alert] %></div>
  <% end %>

  <% if @news.any? %>
    <ul class="list-group">
      <% @news.each do |article| %>
        <li class="list-group-item">
          <h2 class="h5">
            <a href="<%= article['url'] %>" target="_blank" class="text-primary"><%= article['title'] %></a>
          </h2>
          <p><%= article['description'] %></p>
          <p class="text-muted">
            <small>提供元: <%= article['source']['name'] %> | 公開日: <%= article['publishedAt'].to_date %></small>
          </p>
        </li>
      <% end %>
    </ul>
  <% else %>
    <div class="alert alert-info">現在、日本経済に関連するニュースは見つかりませんでした。</div>
  <% end %>
</div>
