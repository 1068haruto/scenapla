<% if article %>
  <div class="acc-item">
    <h2 class="acc-header" id="heading-<%= acc_id %>-<%= index %>">
      <button
        class="acc-button collapsed d-flex align-items-start"
        type="button"
        data-bs-toggle="collapse"
        data-bs-target="#collapse-<%= acc_id %>-<%= index %>"
        aria-expanded="false"
        aria-controls="collapse-<%= acc_id %>-<%= index %>"
      >
        <% if article['image'] %>
          <img
            src="<%= article['image'] %>"
            alt="<%= article['title'] %>"
            class="me-3"
            style="width: 50px; height: 50px; object-fit: cover; border-radius: 5px;"
          >
        <% else %>
          <img
            src="/placeholder-image.jpg"
            alt="No Image"
            class="me-3"
            style="width: 50px; height: 50px; object-fit: cover; border-radius: 5px;"
          >
        <% end %>

        <div>
          <h5 class="mb-1"><%= article['title'] %></h5>
          <p class="text-muted mb-0">
            <small>
              提供元: <%= article['source']['name'] %> | 公開日: <%= article['publishedAt'].to_date %>
            </small>
          </p>
        </div>
      </button>
    </h2>
    <div
      id="collapse-<%= acc_id %>-<%= index %>"
      class="acc-collapse collapse"
      aria-labelledby="heading-<%= acc_id %>-<%= index %>"
      data-bs-parent="#<%= acc_id %>"
    >
      <div class="acc-body">
        <p><%= article['description'] %></p>
        <ahref="<%= article['url'] %>" target="_blank" class="text-primary ">
          記事全文を確認する
        </a>
      </div>
    </div>
  </div>
<% end %>
