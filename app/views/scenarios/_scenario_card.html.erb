<div class="card mb-4">
  <div class="card-header">
    <h4 class="mt-2"><%= title %></h4>
  </div>
  <div class="card-body">
    <% if !balance_chart_data.empty? && @incomes.any? && @expenses.any? %>
      <div class="mb-4">
        <span class="mb-4"><%= formatted_date(updated_at) %>時点</span>
      </div>
      <%= render 'balance_summary', total_income: total_income, total_expense: total_expense, total_balance: total_balance %>
      <%= render 'withdrawal_and_shortage', withdrawal: withdrawal, shortage: shortage %>
      <%= balance_chart(balance_chart_data, title) %>
    <% else %>
      <p>情報入力が不足しているため、表示できません。</p>
    <% end %>
  </div>
</div>
