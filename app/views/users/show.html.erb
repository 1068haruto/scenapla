<div class="container">
  <% content_for :title do %>Account<% end %>
    <div class="mb-5 text-center">
      <h1 class="display-4">Account</h1>
    </div>

  <div class="container mt-5">
    <div class="card mb-4 mx-auto" style="max-width: 800px;">
      <div class="card-body text-center">
        <h5 class="card-title mb-4">アカウント情報</h5>
        <p class="card-text">ユーザー名: <strong><%= @user.name %></strong></p>
        <p class="card-text">生年月日: <strong><%= @user.date_of_birth.strftime("%Y年%-m月%-d日") %></strong></p>
        <p class="card-text">メールアドレス: <strong><%= @user.email %></strong></p>
        <p class="card-text">アカウント作成日: <strong><%= @user.created_at.strftime("%Y年%-m月%-d日") %></strong></p>
        <p class="card-text">アカウント更新日: <strong><%= @user.updated_at.strftime("%Y年%-m月%-d日") %></strong></p>
      </div>
    </div>
  </div>

    <div class="d-flex justify-content-center">
      <%= link_to '変更', edit_user_path, class: 'btn btn-outline-primary mx-2', data: { turbo_method: :get } %>
      <%= link_to '削除', user_registration_path, class: 'btn btn-outline-danger mx-2', data: { confirm: '削除しても良いですか？', turbo_method: :delete } %>
    </div>
  </div>
</div>
