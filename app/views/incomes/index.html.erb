<% content_for :title do %>Incomes<% end %>

<div class="container">
  <div class="mt-3 mb-5 text-center">
    <h1 class="display-4">Incomes</h1>
    <h4 class="mb-3">現在の収入と退職ついて教えてください</h4>
  </div>

  <div class="row d-flex justify-content-center">
    <div class="col-11 border border-dark rounded p-3 mb-4">
      <%= render 'income_form', income: @income %>
    </div>

    <div class="col-11 mb-4">
      <h5>追加した収入データ</h5>
      <% if @incomes.any? %>
        <div class="accordion" id="incomesAccordion">
          <% @incomes.each_with_index do |income, index| %>
            <%= render 'registered_income', income: income, index: index, accordion_id: "incomesAccordion" %>
          <% end %>
        </div>
      <% else %>
        <p class="text-secondary">&nbsp;&nbsp;データがありません。</p>
      <% end %>
    </div>
  </div>

  <div class="d-flex justify-content-center">
    <%= link_to 'ホームに戻る', dashboard_index_path, class: 'btn btn-outline-secondary me-2', data: { turbo: true } %>
    <% if @incomes.any? %>
      <%= button_to '保存して次へ', update_income_data_simulation_path, class: 'btn btn-primary', method: :post, data: { turbo: true } %>
    <% end %>
  </div>
</div>
