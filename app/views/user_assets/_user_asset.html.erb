<% if user_asset.persisted? %>
  <tr>
    <th scope="row" class="px-1"><%= index %></th>
    <td class="px-1"><%= user_asset.person_type %></td>
    <td class="px-1"><%= user_asset.asset_type %></td>
    <td class="px-1"><%= user_asset.amount %>万円</td>
    <td class="px-1"><%= user_asset.return_rate.present? ? "#{user_asset.return_rate}%" : 'なし' %></td>
    <td class="pt-1 px-1">
      <%= link_to '削除', user_asset_path(user_asset), class: 'btn btn-outline-danger btn-sm px-1 py-1', data: { turbo_method: :delete } %>
    </td>
  </tr>
<% end %>
