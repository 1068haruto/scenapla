<% if expense.persisted? %>
  <div class="accordion" id="expensesAccordion">
    <div class="accordion-item">
      <h2 class="accordion-header" id="heading-<%= accordion_id %>">
        <button 
          class="accordion-button collapsed"
          type="button"
          data-bs-toggle="collapse"
          data-bs-target="#collapse-<%= accordion_id %>"
          aria-expanded="false"
          aria-controls="collapse-<%= accordion_id %>"
        >
          <span class="badge rounded-pill text-primary">現在の支出</span>
        </button>
      </h2>
      <div
        id="collapse-<%= accordion_id %>"
        class="accordion-collapse collapse"
        aria-labelledby="heading-<%= accordion_id %>"
        data-bs-parent="#<%= accordion_id %>"
      >
        <div class="accordion-body">
          <ul class="list-unstyled">
            <li><strong>住居費（家賃orローン）:</strong> <%= expense.housing_expenses %>万円</li>
            <li>
              <strong>住宅ローン完済時期:</strong>
              <%= expense.repayment_date&.year ? "#{expense.repayment_date.year}年" : '支払いなし' %>
            </li>
            <li><strong>生活費:</strong> <%= expense.living_expenses %>万円</li>
            <li><strong>保険費（貯蓄型は除く）:</strong> <%= expense.monthly_premiums %>万円</li>
            <li><strong>その他費用:</strong> <%= expense.other_expenses %>万円</li>
          </ul>
          <div class="mt-2">
            <%= link_to '削除', expense_path(expense), class: 'btn btn-outline-danger btn-sm px-1 py-1', data: { turbo_method: :delete } %>
          </div>
        </div>
      </div>
    </div>
  </div>
<% end %>