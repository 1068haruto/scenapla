<% content_for :title do %>News<% end %>

<div class="container">
  <%= render 'shared/page_hd', title: 'News', subtitle: '経済情報をチェック' %>

  <% if @news.any? %>
    <div class="accordion">
      <% @news.each_with_index do |article, index| %>
        <div class="accordion-item">
          <h2 class="accordion-header" id="heading-newsAcc>-<%= index %>">
            <button class="accordion-button collapsed d-flex align-items-start"
              type="button"
              data-bs-toggle="collapse"
              data-bs-target="#collapse-newsAcc-<%= index %>"
              aria-expanded="false"
              aria-controls="collapse-newsAcc-<%= index %>"
            >
              <% if article['image'] %>
                <img src="<%= article['image'] %>" alt="<%= article['title'] %>" class="me-3"
                  style="width: 50px; height: 50px; object-fit: cover; border-radius: 5px;"
                >
              <% else %>
                <img src="/placeholder-image.jpg" alt="No Image" class="me-3"
                  style="width: 50px; height: 50px; object-fit: cover; border-radius: 5px;"
                >
              <% end %>

              <div>
                <h5 class="mb-1"><%= article['title'] %></h5>
                <p class="text-muted mb-0">
                  <small>提供元: <%= article['source']['name'] %> | 公開日: <%= article['publishedAt'].to_date %></small>
                </p>
              </div>
            </button>
          </h2>

          <div class="acc-collapse collapse"
            id="collapse-newsAcc-<%= index %>"
            aria-labelledby="heading-newsAcc-<%= index %>"
            data-bs-parent="#newsAcc"
          >
            <div class="acc-body">
              <p><%= article['description'] %></p>
              <%= link_to '記事全文を確認する', article['url'], target: '_blank', class: 'text-primary' %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="alert alert-info">ニュースを取得できません。</div>
  <% end %>
</div>
