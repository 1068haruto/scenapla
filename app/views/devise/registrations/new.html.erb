<div class="container">
  <% content_for :title do %>Sign up<% end %>
  <div class="mb-5 text-center">
    <h1 class="display-4">Sign up</h1>
  </div>

  <div class="row justify-content-center">
    <div class="col-10 col-md-4 border border-dark p-3 rounded bg-light">
      <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>

        <%= render "devise/shared/error_messages", resource: resource %>

        <div class="form-floating mb-3">
          <%= f.text_field :name, class: 'form-control', id: 'floatingName', placeholder: 'name@example.com', autofocus: true, autocomplete: 'email' %>
          <%= f.label :name, 'ユーザー名', class: 'form-label', for: 'floatingName' %>
        </div>

        <div class="form-floating mb-3">
          <%= f.text_field :date_of_birth, class: 'form-control', id: 'floatingBirthday', placeholder: 'YYYY-MM-DD', pattern: '\d{4}-\d{2}-\d{2}' %>
          <%= f.label :date_of_birth, '生年月日', class: 'form-label', for: 'floatingBirthday' %>
          <small class="form-text text-muted">例: 1990-01-01</small>
        </div>

        <div class="form-floating mb-3">
          <%= f.email_field :email, class: 'form-control', id: 'floatingEmail', placeholder: 'name@example.com', autocomplete: 'email' %>
          <%= f.label :email, 'メールアドレス', class: 'form-label', for: 'floatingEmail' %>
        </div>

        <div class="form-floating mb-3">
          <%= f.password_field :password, class: 'form-control', id: 'floatingPassword', placeholder: 'Password', autocomplete: "new-password" %>
          <%= f.label :password, 'パスワード', class: 'form-label', for: 'floatingPassword' %>
        </div>

        <div class="form-floating mb-3">
          <%= f.password_field :password_confirmation, class: 'form-control', id: 'floatingPasswordConfirm', placeholder: 'Confirm Password', autocomplete: "new-password" %>
          <%= f.label :password_confirmation, 'パスワード(確認用)', class: 'form-label', for: 'floatingPasswordConfirm' %>
        </div>

        <div class="actions text-center mb-3">
          <%= f.submit "アカウント登録", class: 'btn btn-outline-success' %>
        </div>
      <% end %>

      <%= render "devise/shared/links" %>
    </div>
  </div>

  <div class="row justify-content-center mt-3">
    <div class="col-10 col-md-4 border border-dark p-3 rounded d-flex justify-content-center align-items-center bg-light flex-nowrap">
      <p class="mb-0 me-2"><strong>アカウントをお持ちの方</strong></p>
      <%= link_to 'ログイン', new_user_session_path, class: 'btn btn-outline-primary', data: { turbo: true } %>
    </div>
  </div>
</div>
