<% content_for :title do %>Scenarios<% end %>

<div class="container">
  <div class="mt-3 mb-5 text-center">
    <h1 class="display-4">Scenarios</h1>
    <h4 class="mb-3">シミュレーション結果</h4>
    <%= button_to '表示 / 更新', update_scenarios_scenarios_path, method: :post, class: 'btn btn-outline-primary mb-3' %>
  </div>

  <div class="card mb-4">
    <div class="card-header">
      <h4 class="mt-2">資産寿命シナリオ</h4>
    </div>
    <div class="card-body">
      <% if @asset_lifespan && @asset_lifespan.asset_lifespan_scenario.present? %>
        <div class="mb-4">
          <span class="mb-4"><%= formatted_date(@asset_lifespan_updated_at) %>時点</span>
        </div>
        <p>
          あなたの資産寿命は、<strong><%= @lifespan_years %>年<%= @lifespan_months %>ヶ月</strong> です。（現在の生活水準の場合）
          <br>
          資産を時間に換算し、本質的な資産の強さを表しています。
        </p>
        <%= lifespan_chart(@lifespan_chart_data) %>
      <% else %>
        <p>情報入力が不足している為、表示できません。</p>
      <% end %>
    </div>
  </div>

  <div class="card mb-4">
    <div class="card-header">
      <h4 class="mt-2">現実的シナリオ</h4>
    </div>
    <div class="card-body">
      <% if !@real_balance_chart_data.empty? && @incomes.any? && @expenses.any? %>
        <div class="mb-4">
          <span><%= formatted_date(@real_updated_at) %>時点</span>
        </div>
        <%= render 'balance_summary', total_income: @real_total_income,
                                      total_expense: @real_total_expense,
                                      total_balance: @real_total_balance %>
        <%= render 'withdrawal_and_shortage', withdrawal: @real_withdrawal, shortage: @real_shortage %>
        <%= balance_chart(@real_balance_chart_data, "現実シナリオ") %>
      <% else %>
        <p>情報入力が不足している為、表示できません。</p>
      <% end %>
    </div>
  </div>

  <div class="card mb-4">
    <div class="card-header">
      <h4 class="mt-2">理想的シナリオ</h4>
    </div>
    <div class="card-body">
      <% if !@ideal_balance_chart_data.empty? && @incomes.any? && @expenses.any? %>
        <div class="mb-4">
          <span><%= formatted_date(@ideal_updated_at) %>時点</span>
        </div>
        <%= render 'balance_summary', total_income: @ideal_total_income,
                                      total_expense: @ideal_total_expense,
                                      total_balance: @ideal_total_balance %>
        <%= render 'withdrawal_and_shortage', withdrawal: @ideal_withdrawal, shortage: @ideal_shortage %>
        <%= balance_chart(@ideal_balance_chart_data, "理想シナリオ") %>
      <% else %>
        <p>情報入力が不足しているため、表示できません。</p>
      <% end %>
    </div>
  </div>

  <div class="card mb-4">
    <div class="card-header">
      <h4 class="mt-2">運用資産シナリオ</h4>
    </div>
    <div class="card-body">
      <% if !@asset_data.empty? && @user_assets.any? %>
        <div class="mb-4">
          <span><%= formatted_date(@user_asset_data_updated_at) %>時点</span>
        </div>
        <p>
          現在の資産を元にした今後の推移です。
          <br>
          積立や取り崩しを行った場合は、資産情報を更新してください。
        </p>
        <%= asset_chart(@asset_data) %>
      <% else %>
        <p>資産情報が未登録のため、表示できません。</p>
      <% end %>
    </div>
  </div>

  <div class="d-flex justify-content-center">
    <% if @simulation.user_asset_data.nil? || @simulation.user_asset_data.empty? %>
      <%= link_to '情報入力画面へ', incomes_path, class: 'btn btn-primary me-2', data: { turbo_method: :get } %>
    <% else %>
      <%= link_to '条件を変えて再入力', incomes_path, class: 'btn btn-secondary me-2', data: { turbo: true } %>
      <%= link_to 'ライフプランへ', life_events_path, class: 'btn btn-primary me-2', data: { turbo: true } %>
    <% end %>
  </div>
</div>
