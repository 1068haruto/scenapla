<% content_for :title do %>Scenarios<% end %>

<div class="container">
  <div class="mt-3 mb-5 text-center">
    <h1 class="display-4">Scenarios</h1>
    <h4 class="mb-3">シミュレーション結果</h4>
    # todo: helper, turbo
    <%= button_to '表示 / 更新',
      update_scenarios_lifespan_scenarios_path,
      method: :post, class: 'btn btn-outline-primary mb-3'
    %>
  </div>

  <!-- 資産寿命シナリオ -->
  <% @vm = @view_model.asset_lifespan_vm %>
  <div class="card mb-4">
    <div class="card-header d-flex align-items-center">
      <h4 class="mt-2">資産寿命シナリオ</h4>
      <% if @vm.show? %>
        <span class="ms-auto"><%= formatted_date(@vm.updated_at) %>時点</span>
      <% end %>
    </div>

    <div class="card-body">
      <% if @vm.show? %>
        <p>資産寿命：<%= @vm.lifespan_years %>年<%= @vm.lifespan_months %>ヶ月</p>
        <%= lifespan_chart(@vm.lifespan_chart_data) %>
      <% else %>
        <p>支出または資産情報が未登録ため、表示できません。</p>
      <% end %>
    </div>
  </div>

  <!-- 現実シナリオ -->
  <% @vm = @view_model.real_scenario_vm %>
  <div class="card mb-4">
    <%= render 'balance_scenario_card',
      title: "現実的シナリオ",
      updated_at: @vm.updated_at,
      balance_chart_data: @vm.balance_chart_data,
      total_income: @vm.total_income,
      total_expense: @vm.total_expense,
      total_balance: @vm.total_balance,
      withdrawal: @vm.withdrawal,
      shortage: @vm.shortage,
      show: @vm.show?
    %>
  </div>

  <!-- 理想シナリオ -->
  <% @vm = @view_model.ideal_scenario_vm %>
  <div class="card mb-4">
    <%= render 'balance_scenario_card',
      title: "理想的シナリオ",
      updated_at: @vm.updated_at,
      balance_chart_data: @vm.balance_chart_data,
      total_income: @vm.total_income,
      total_expense: @vm.total_expense,
      total_balance: @vm.total_balance,
      withdrawal: @vm.withdrawal,
      shortage: @vm.shortage,
      show: @vm.show?
    %>
  </div>

  <!-- 資産運用シナリオ -->
  <% @vm = @view_model.asset_scenario_vm %>
  <div class="card mb-4">
    <div class="card-header d-flex align-items-center">
      <h4 class="mt-2">資産運用シナリオ</h4>
      <% if @vm.show? %>
        <span class="ms-auto">
          <%= formatted_date(@vm.updated_at) %>時点
        </span>
      <% end %>
    </div>

    <div class="card-body">
      <% if @vm.show? %>
        <p>現在資産を基にした推移</p>
        <%= asset_chart(@vm.asset_data) %>
      <% else %>
        <p>資産情報が未登録のため、表示できません。</p>
      <% end %>
    </div>
  </div>

  <% if @view_model.show_next_button? %>
    <p class="mb-5 text-muted">
      ※ 各シナリオは、特定の前提条件に基づいて算出した概算値であり、
      市場の動向や個々の状況変化により、実際の数値とは異なる場合があります。<br>
      &nbsp;&nbsp;&nbsp;将来を保証するものではなく、意思決定の補助としてご利用ください。
    </p>
  <% end %>

  <div class="d-flex justify-content-center">
    <% if @view_model.show_next_button? %>
      <%= back_button('条件を変えて再入力', incomes_path) %>
      <%= next_button_get('ライフプランへ', life_plans_path) %>
    <% else %>
      <%= next_button_get('情報入力画面へ', incomes_path) %>
    <% end %>
  </div>
</div>
