<%= form_with model: income, local: true do |f| %>
  <%# 横並び、高さ中央 %>
  <div class="row align-items-center justify-content-center">

    <%# 入力フォーム群 %>
    <div class="col-md-9 border border-gray rounded p-4">
      <div class="mb-3 row">
        <%= f.label :person_type, '対象者', class: 'col-sm-4 col-form-label' %>
        <div class="col-sm-8">
          <%= f.select :person_type, Income.person_types.keys.map { |type| [type, type] }, {}, class: 'form-select', autofocus: true %>
        </div>
      </div>

      <div class="mb-3 row">
        <%= f.label :monthly_income, '月収(手取り)', class: 'col-sm-4 col-form-label' %>
        <div class="col-sm-8">
          <div class="input-group">
            <%= f.number_field :monthly_income, class: 'form-control', step: 0.1, required: true %>
            <span class="input-group-text">万円</span>
          </div>
        </div>
      </div>

      <div class="mb-3 row">
        <%= f.label :yearly_bonus, '賞与年額(手取り)', class: 'col-sm-4 col-form-label' %>
        <div class="col-sm-8">
          <div class="input-group">
            <%= f.number_field :yearly_bonus, class: 'form-control', step: 0.1, required: true %>
            <span class="input-group-text">万円</span>
          </div>
        </div>
      </div>

      <div class="mb-3 row">
        <%= f.label :retirement_date, '退職時期', class: 'col-sm-4 col-form-label' %>
        <div class="col-sm-8">
          <div class="input-group">
            <%= f.select :retirement_date, options_for_select((Date.today.year..(Date.today.year + 50)).map { |year| [year, year] }, income.retirement_date&.year), {}, class: 'form-select' %>
            <span class="input-group-text">年</span>
          </div>
        </div>
      </div>

      <div class="row">
        <%= f.label :retirement_pay, '退職金(手取り)', class: 'col-sm-4 col-form-label' %>
        <div class="col-sm-8">
          <div class="input-group">
            <%= f.number_field :retirement_pay, class: 'form-control', step: 0.1, required: true %>
            <span class="input-group-text">万円</span>
          </div>
        </div>
      </div>
    </div>

    <%# ボタン表示エリア %>
    <div class="col-md-3 text-center">
      <div class="d-grid gap-2 ps-2">
        <%= submit_or_add_button(f, income) %>
        <% if income.persisted? %>
          <%= cancel_button(incomes_path) %>
        <% end %>
      </div>
    </div>

  </div>
<% end %>
