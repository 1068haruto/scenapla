<% content_for :title do %>Incomes<% end %>

<div class="container">
  <div class="mb-5">
    <h1 class="display-4">Incomes</h1>
    <h4 class="mb-3">現在の月収入と退職ついて教えてください。</h4>
  </div>

  <div class="row d-flex justify-content-center">
    <div class="col-11 border border-dark rounded p-3 mb-4">
      <%= form_with model: @income, url: incomes_path, local: true, id: "income-form" do |f| %>
        <div class="row">
          <div class="col-md">
            <%= f.label :person_type, '対象', class: 'form-label mb-0' %>
            <%= f.select :person_type, Income.person_types.keys.map { |type| [type, type] }, {}, class: 'form-select', autofocus: true %>
          </div>

          <div class="col-md">
            <%= f.label :income, '月収（手取り）', class: 'form-label mb-0' %>
            <div class="input-group">
              <%= f.number_field :income, class: 'form-control' %>
              <span class="input-group-text">万円</span>
            </div>
          </div>

          <div class="col-md">
            <%= f.label :retirement_date, '退職時期', class: 'form-label mb-0' %>
            <div class="input-group">
              <%=
                f.select :retirement_date,
                options_for_select((Date.today.year..(Date.today.year + 50)).map { |year| [year, year] }), {},
                class: 'form-select'
              %>
              <span class="input-group-text">年</span>
            </div>  
          </div>

          <div class="col-md">
            <%= f.label :retirement_pay, '退職金（手取り）', class: 'form-label mb-0' %>
            <div class="input-group">
              <%= f.number_field :retirement_pay, class: 'form-control' %>
              <span class="input-group-text">万円</span>
            </div>
          </div>
        </div>

        <div class="mt-3 d-flex justify-content-center">
          <%= f.submit '追加', class: 'btn btn-outline-primary' %>
        </div>
      <% end %>
    </div>

    <div class="col-11 p-3 mb-4">
      <div class="row">
        <h5>追加した収入データ</h5>
        <% if @incomes.any? %>
          <table class="table table-hover">
            <thead>
              <tr>
                <th scope="col" class="px-1"></th>
                <th scope="col" class="px-1">対象</th>
                <th scope="col" class="px-1">月収</th>
                <th scope="col" class="px-1">退職時期</th>
                <th scope="col" class="px-1">退職金</th>
                <th scope="col" class="px-1"></th>
              </tr>
            </thead>

            <tbody class="table-group-divider">
              <% @incomes.each_with_index do |income, index| %>
                <%= render partial: 'income', locals: { income: income, index: index + 1 } %>
              <% end %>
            </tbody>
          </table>
        <% else %>
          <p class="text-secondary">&nbsp;&nbsp;データがありません。</p>
        <% end %>
      </div>
    </div>
  </div>

  <div class="d-flex justify-content-center">
    <%= link_to 'ホームに戻る', dashboard_path, class: 'btn btn-outline-secondary me-2', data: { turbo: true } %>
    <% if @incomes.any? %>
      <%=
        button_to '保存して次へ', update_simulation_data_incomes_path(simulation_id: current_user.simulation.id),
        method: :post, class: 'btn btn-primary', data: { turbo: true }
      %>
    <% end %>
  </div>
</div>
