<%= form_with model: life_event, local: true do |f| %>
  <%= render layout: 'shared/form_wrapper', locals: { f: f, model: life_event, back_path: life_events_path } do %>

    <%= render layout: 'shared/form_row', locals: { f: f, field: :event_type, label_text: 'イベントタイプ' } do %>
      <%= f.select :event_type, [['現実', 0], ['理想', 1]], { selected: life_event.event_type_before_type_cast }, class: 'form-select', autofocus: true %>
    <% end %>

    <%= render layout: 'shared/form_row', locals: { f: f, field: :event_date, label_text: '時期', unit: '年' } do %>
      <%= f.select :event_date, options_for_select((Date.today.year..(Date.today.year + 50)).map { |year| [year, year] }, life_event.event_date&.year), {}, class: 'form-select' %>
    <% end %>

    <%= render layout: 'shared/form_row', locals: { f: f, field: :title, label_text: 'タイトル' } do %>
      <%= f.text_field :title, class: 'form-control', placeholder: '引越し、車購入、結婚など...', required: true %>
    <% end %>

    <%= render layout: 'shared/form_row', locals: { f: f, field: :amount, label_text: '年額', unit: '万円' } do %>
      <%= f.number_field :amount, class: 'form-control', step: 0.1, required: true %>
    <% end %>

    <%= render layout: 'shared/form_row', locals: { f: f, field: :payment_period, label_text: '支払期間', unit: '年間', last: true } do %>
      <%= f.select :payment_period, LifeEvent::PAYMENT_PERIOD_OPTIONS.map { |n| ["#{n}", n] }, {}, class: 'form-select' %>
    <% end %>

  <% end %>
<% end %>