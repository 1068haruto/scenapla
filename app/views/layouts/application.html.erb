<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Scenapla" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <!-- bootstrapのCSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
    <!-- FontAwesomeのJSキット -->
    <script src="https://kit.fontawesome.com/8096f95eec.js" crossorigin="anonymous"></script>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
  </head>

  <body>
    <header>
      <nav class="navbar navbar-dark">
        <div class="container-fluid">
          <!-- ブランドロゴ -->
          <%= link_to 'Scenapla', user_signed_in? ? dashboard_path : root_path, class: 'navbar-brand', data: { turbo: false } %>

          <% if user_signed_in? %>
            <!-- ハンバーガーメニュー (offcanvas トリガー) -->
            <button class="navbar-toggler" type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvasNavbar" aria-controls="offcanvasNavbar">
              <span class="navbar-toggler-icon"></span>
            </button>

            <!-- Offcanvas メニュー -->
            <div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasNavbar" aria-labelledby="offcanvasNavbarLabel">
              <div class="offcanvas-header">
                <h5 class="offcanvas-title" id="offcanvasNavbarLabel"><%= "#{current_user.name}さん" %></h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Close"></button>
              </div>
              <div class="offcanvas-body">
                <!-- ページボタン -->
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                  <li class="nav-item">
                    <%= link_to 'ホーム', dashboard_path, class: 'nav-link', data: { turbo: true } %>
                  </li>

                  <li class="nav-item dropdown">
                    <%= link_to 'シミュレーション', '#', class: 'nav-link dropdown-toggle', id: 'simulationDropdown', role: 'button', data: { bs_toggle: 'dropdown' }, aria: { expanded: 'false' } %>
                    <ul class="dropdown-menu dropdown-menu-dark" aria-labelledby="simulationDropdown">
                      <li><%= link_to 'はじめから入力', incomes_path, class: 'dropdown-item', data: { turbo: true } %></li>
                      <li><%= link_to '収入入力', incomes_path, class: 'dropdown-item', data: { turbo: true } %></li>
                      <li><%= link_to '支出入力', expenses_path, class: 'dropdown-item', data: { turbo: true } %></li>
                      <li><%= link_to '資産入力', user_assets_path, class: 'dropdown-item', data: { turbo: true } %></li>
                      <li><%= link_to 'ライフイベント入力', new_life_event_path, class: 'dropdown-item', data: { turbo: true } %></li>
                    </ul>
                  </li>

                  <li class="nav-item">
                    <%= link_to 'シナリオ', scenarios_path, class: 'nav-link', data: { turbo: true } %>
                  </li>

                  <li class="nav-item">
                    <%= link_to 'ライフプラン', life_events_path, class: 'nav-link', data: { turbo: true } %>
                  </li>

                  <li class="nav-item dropdown">
                    <%= link_to 'アカウント', '#', class: 'nav-link dropdown-toggle', id: 'navbarDropdown', role: 'button', data: { bs_toggle: 'dropdown' }, aria: { expanded: 'false' } %>
                    <ul class="dropdown-menu dropdown-menu-dark" aria-labelledby="navbarDropdown">
                      <li><%= link_to 'アカウント情報', user_path(current_user), class: 'dropdown-item' %></li>
                      <li><hr class="dropdown-divider"></li>
                      <li><%= link_to 'ログアウト', destroy_user_session_path, data: { turbo_method: :delete }, class: 'dropdown-item' %></li>
                    </ul>
                  </li>
                </ul>
              </div>
            </div>
          <% else %>
            <%= link_to 'ログイン', new_user_session_path, class: 'btn btn-outline-light', data: { turbo: true } %>
          <% end %>
        </div>
      </nav>
    </header>

    <main>
      <ul class="nav nav-tabs justify-content-center bg-light sticky-top">
        <li class="nav-item">
          <%= link_to dashboard_path, class: "nav-link text-muted #{'active fw-bold' if current_page?(dashboard_path)}", data: { turbo: true } do %>
            <span class="d-none d-sm-inline">ホーム</span>
            <i class="fa-solid fa-house d-sm-none"></i>
          <% end %>
        </li>

        <li class="nav-item dropdown">
          <%= link_to '#', class: "nav-link dropdown-toggle text-muted #{'active fw-bold' if [incomes_path, expenses_path, user_assets_path, new_life_event_path].include?(request.fullpath)}", id: 'navbarDropdown', data: { bs_toggle: 'dropdown', turbo: true }, aria: { expanded: 'false' } do %>
            <span class="d-none d-sm-inline">シミュレーション</span>
            <i class="fa-regular fa-keyboard d-sm-none"></i>
          <% end %>
          <ul class="dropdown-menu" aria-labelledby="navbarDropdown">
            <li><%= link_to 'はじめから入力', incomes_path, class: "dropdown-item text-muted", data: { turbo: true } %></li>
            <li><%= link_to '収入入力', incomes_path, class: "dropdown-item text-muted", data: { turbo: true } %></li>
            <li><%= link_to '支出入力', expenses_path, class: "dropdown-item text-muted", data: { turbo: true } %></li>
            <li><%= link_to '資産入力', user_assets_path, class: "dropdown-item text-muted", data: { turbo: true } %></li>
            <li><%= link_to 'ライフイベント入力', new_life_event_path, class: "dropdown-item text-muted", data: { turbo: true } %></li>
          </ul>
        </li>

        <li class="nav-item">
          <%= link_to scenarios_path, class: "nav-link text-muted #{'active fw-bold' if current_page?(scenarios_path)}", data: { turbo: true } do %>
            <span class="d-none d-sm-inline">シナリオ</span>
            <i class="fa-solid fa-chart-line d-sm-none"></i>
          <% end %>
        </li>

        <li class="nav-item">
          <%= link_to life_events_path, class: "nav-link text-muted #{'active fw-bold' if current_page?(life_events_path)}", data: { turbo: true } do %>
            <span class="d-none d-sm-inline">ライフプラン</span>
            <i class="fa-regular fa-map d-sm-none"></i>
          <% end %>
        </li>
      </ul>

      <% if notice %>
        <div class="alert alert-success alert-dismissible fade show" role="alert">
          <%= notice %>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      <% end %>

      <% if alert %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
          <%= alert %>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      <% end %>

      <% if flash.now[:error] %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
          <%= flash.now[:error] %>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      <% end %>

      <%= yield %> <!-- 各ページの内容がここに挿入される -->
    </main>

    <footer class="py-4">
      <div class="container d-flex flex-column flex-md-row justify-content-between align-items-center">
        <!-- ページボタン -->
        <div>
          <%= link_to 'お問い合わせ', 
                "https://docs.google.com/forms/d/e/1FAIpQLSfs5-SIS7h3jQtT4F3ulKjLrdgpX-EJjNNPqpkwhuBQ6s41dA/viewform?usp=sf_link", 
                class: "btn btn-link px-2", target: "_blank", rel: "noopener", data: { turbo: true } %>
          <%= link_to 'プライバシーポリシー', static_pages_privacy_path, class: "btn btn-link px-2", data: { turbo: true } %>
          <%= link_to '利用規約', static_pages_terms_path, class: "btn btn-link px-2", data: { turbo: true } %>
        </div>
        <!-- コピーライト -->
        <div class="text-center mt-md-0">
          &copy; <%= Time.now.year %> My Website. All rights reserved.
        </div>
      </div>
    </footer>
  </body>
</html>
