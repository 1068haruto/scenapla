<%= form_with model: user_asset, local: true do |f| %>
  <%= render layout: 'shared/form_wrapper', locals: { f: f, model: user_asset, back_path: user_assets_path } do %>

    <%= render layout: 'shared/form_row', locals: { f: f, field: :person_type, label_text: '対象者' } do %>
      <%= f.select :person_type, UserAsset.person_types.keys.map { |key| [key.humanize, key] }, {}, class: "form-select", autofocus: true %>
    <% end %>

    <%= render layout: 'shared/form_row', locals: { f: f, field: :asset_type, label_text: '資産種類' } do %>
      <%= f.select :asset_type, UserAsset.asset_types.keys.map { |key| [key.humanize, key] }, {}, class: "form-select" %>
    <% end %>

    <%= render layout: 'shared/form_row', locals: { f: f, field: :amount, label_text: '総額', unit: '万円' } do %>
      <%= f.number_field :amount, class: "form-control", step: 0.1, required: true %>
    <% end %>

    <%= render layout: 'shared/form_row', locals: { f: f, field: :return_rate, label_text: '利回り', unit: '%', last: true } do %>
      <%= f.number_field :return_rate, class: "form-control", step: 0.1, required: true %>
    <% end %>

  <% end %>
<% end %>