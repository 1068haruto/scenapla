<h1>Incomes</h1>
<%= form_with model: @income, url: incomes_path, local: false do |f| %>
  <div>
    <%= f.label :person_type, '対象者' %>
    <%= f.select :person_type, [['本人', '本人'], ['配偶者', '配偶者']], prompt: '選択してください' %>
  </div>
  <div>
    <%= f.label :income, '月収（手取り）' %>
    <%= f.number_field :income %>
  </div>
  <div>
    <%= f.label :retirement_date, '退職時期' %>
    <%= f.select :retirement_date, (Date.today.year..(Date.today.year + 100)).map { |year| [year, Date.new(year, 1, 1)] }, prompt: '選択してください' %>
  </div>
  <div>
    <%= f.label :retirement_pay, '退職金' %>
    <%= f.number_field :retirement_pay %>
  </div>
  <%= f.submit '保存', class: 'btn btn-primary' %>
<% end %>
<div id="incomes">
  <%= render @incomes %>
</div>


<form id="myForm">
  <input type="text" id="inputField" placeholder="入力フォーム" />
  <button type="button" id="saveButton" class='btn btn-primary'>保存</button>
  <button type="button" id="editButton" class='btn btn-primary' style="display: none;">編集</button>
</form>

<script>
  const inputField = document.getElementById('inputField');
  const saveButton = document.getElementById('saveButton');
  const editButton = document.getElementById('editButton');

  saveButton.addEventListener('click', () => {
    inputField.disabled = true;  // 入力欄をロック
    saveButton.style.display = 'none';  // 保存ボタンを隠す
    editButton.style.display = 'inline';  // 編集ボタンを表示
  });

  editButton.addEventListener('click', () => {
    inputField.disabled = false;  // 入力欄のロックを解除
    editButton.style.display = 'none';  // 編集ボタンを隠す
    saveButton.style.display = 'inline';  // 保存ボタンを表示
  });
</script>