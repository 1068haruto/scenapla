<% content_for :title do %>LifeEvents<% end %>

<div class="mb-5">
  <h1>LifeEvents</h1>
  <h4>ライフイベントについて教えて下さい。</h4>
  <p>※金額は全てプラス値で入力</p>
  <p>※起こることが確定しているイベントは「現実」、確定していないイベントは「理想」を選択</p>
</div>

<%= form_with model: @life_event, local: true, id: "life-event-form" do |f| %>
  <%= f.hidden_field :user_id, value: current_user.id %>
  <%= f.hidden_field :simulation_id, value: current_user.simulation.id %>
  <div class="row">
    <div class="col-md-2">
      <%= f.label :event_type, 'イベントタイプ', class: 'form-label' %>
      <%= f.select :event_type, [['現実', 0], ['理想', 1]], { include_blank: true }, class: 'form-select' %>
    </div>
    <div class="col-md-2">
      <%= f.label :event_date, '発生時期', class: 'form-label' %>
      <%= f.select :event_date, options_for_select((Date.today.year..(Date.today.year + 50)).map { |year| [year, year] }), {}, class: 'form-select' %>
    </div>
    <div class="col-md-3">
      <%= f.label :title, 'タイトル', class: 'form-label' %>
      <%= f.text_field :title, class: 'form-control', required: true %>
    </div>
    <div class="col-md-2">
      <%= f.label :amount, '年額', class: 'form-label' %>
      <%= f.number_field :amount, class: 'form-control', required: true %>
    </div>
    <div class="col-md-2">
      <%= f.label :payment_span, '支払期間', class: 'form-label' %>
      <%= f.select :payment_span, [['一括', '0'], ['毎年支払い', '1']], { include_blank: true }, class: 'form-select' %>
    </div>
  </div>
  <div class="mb-5">
    <%= f.submit '追加', class: 'btn btn-primary' %>
  </div>
<% end %>

<%= button_to '保存して次へ', update_life_event_data_life_events_path(simulation_id: current_user.simulation.id), method: :post, class: 'btn btn-primary' %>
<%= link_to '資産入力に戻る', user_assets_path, class: 'btn btn-secondary', data: { turbo: true } %>

<div id="life_events">
  <% @life_events.each do |life_event| %>
    <%= render life_event %>
  <% end %>
</div>
