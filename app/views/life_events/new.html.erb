<% content_for :title do %>LifeEvents<% end %>

<div class="container">
  <div class="mb-5">
    <h1 class="display-4">LifeEvents</h1>
    <h4 class="mb-3">今後のライフイベントについて教えて下さい。</h4>
    <p>※必ず実現したいイベントは「現実」、できれば実現したいイベントは「理想」を選択</p>
  </div>
  
  <div class="row d-flex justify-content-center">
    <div class="col-11 border border-dark rounded p-3 mb-4">
      <%= form_with model: @life_event, local: true, id: "life-event-form" do |f| %>
        <%= f.hidden_field :user_id, value: current_user.id %>
        <%= f.hidden_field :simulation_id, value: current_user.simulation.id %>

        <div class="row d-flex justify-content-center">
          <div class="col-md-3 col-lg-3 col-xl-2">
            <%= f.label :event_type, 'イベントタイプ', class: 'form-label' %>
            <%= f.select :event_type, [['現実', 0], ['理想', 1]], { selected: 0 }, class: 'form-select' %>
          </div>

          <div class="col-md-3 col-lg-3 col-xl-2">
            <%= f.label :event_date, '発生時期', class: 'form-label' %>
            <div class="input-group">
              <%= f.select :event_date, options_for_select((Date.today.year..(Date.today.year + 50)).map { |year| [year, year] }), {}, class: 'form-select' %>
              <span class="input-group-text">年</span>
            </div>
          </div>

          <div class="col-md-5 col-lg-4 col-xl-3">
            <%= f.label :title, 'タイトル', class: 'form-label' %>
            <%= f.text_field :title, class: 'form-control', required: true %>
          </div>

          <div class="col-md-3 col-lg-3 col-xl-2">
            <%= f.label :amount, '年額', class: 'form-label' %>
            <div class="input-group">
              <%= f.number_field :amount, class: 'form-control', required: true %>
              <span class="input-group-text">万円</span>
            </div>
          </div>

          <div class="col-md-3 col-lg-2 col-xl-2">
            <%= f.label :payment_span, '支払期間', class: 'form-label' %>
            <div class="input-group">
              <%= f.select :payment_span, (1..10).map { |i| [i.to_s, i] }, {selected: 1 }, class: 'form-select' %>
              <span class="input-group-text">年間</span>
            </div>
          </div>
        </div>

        <div class="mt-3 d-flex justify-content-center">
          <%= f.submit '追加', class: 'btn btn-outline-primary' %>
        </div>
      <% end %>
    </div>

    <div class="col-11 p-3 mb-4">
      <div class="row">
        <h5>追加されている資産データ</h5>
        <% if @life_events.any? %>
          <table class="table table-hover">
            <thead>
              <tr>
                <th scope="col" class="px-1"></th>
                <th scope="col" class="px-1">イベントタイプ</th>
                <th scope="col" class="px-1">発生時期</th>
                <th scope="col" class="px-1">タイトル</th>
                <th scope="col" class="px-1">年額</th>
                <th scope="col" class="px-1">支払期間</th>
                <th scope="col" class="px-1"></th>
              </tr>
            </thead>

            <tbody class="table-group-divider">
              <% @life_events.each_with_index do |life_event, index| %>
                <%= render partial: 'life_event', locals: { life_event: life_event, index: index + 1 } %>
              <% end %>
            </tbody>
          </table>
        <% else %>
          <p class="text-secondary">&nbsp;&nbsp;データがありません。</p>
        <% end %>
      </div>
    </div>
  </div>

  <div class="d-flex justify-content-center">
    <%= link_to '資産に戻る', user_assets_path, class: 'btn btn-outline-secondary me-2', data: { turbo: true } %>
    <% if @life_events.any? %>
      <%=
        button_to '保存して次へ', update_life_event_data_life_events_path(simulation_id: current_user.simulation.id),
        method: :post, class: 'btn btn-primary', data: { turbo: true }
      %>
    <% end %>
  </div>
</div>
