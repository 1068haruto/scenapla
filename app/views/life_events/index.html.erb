<%= render layout: 'shared/input_index_layout', locals: {
  title: 'LifeEvents',
  subtitle: '今後のライフイベントについて教えて下さい',
  description: '必ず行う予定は"現実"、できれば行いたい予定は"理想"を選択',
  form_content: render('life_event_form', life_event: @life_event),
  list_title: '追加したライフイベント情報',
  collection: @life_events,
  acc_id: 'LifeEventsAcc',
  back_path: user_assets_path,
  next_path: update_life_event_data_simulation_path
} do |life_event, index| %>
  <%= render 'shared/acc_item',
    model: life_event,
    acc_id: "lifeEventsAcc",
    index: index,
    badge_text: life_event.event_type,
    badge_class: (life_event.event_type == '理想' ? 'bg-success' : 'bg-primary'),
    extra_title: "#{life_event.event_date.year}年 #{life_event.title}",
    edit_path: edit_life_event_path(life_event),
    delete_path: life_event_path(life_event) do
  %>
    <table class="table table-sm table-borderless mb-0">
      <tbody>
        <tr>
          <th class="fw-bold text-secondary">年額</th>
          <td><%= life_event.amount %>万円</td>
        </tr>
        <tr>
          <th class="fw-bold text-secondary">支払期間</th>
          <td><%= life_event.payment_period %>年間</td>
        </tr>
      </tbody>
    </table>
  <% end %>
<% end %>
