<% content_for :title do %>Expenses<% end %>

<div class="container">
  <div class="mt-3 mb-5 text-center">
    <h1 class="display-4">Expenses</h1>
    <h4 class="mb-3">現在の月支出について教えて下さい</h4>
  </div>

  <div class="row d-flex justify-content-center">
    <div class="col-11 border border-dark rounded p-3 mb-4">
      <%= render 'expense_form', expense: @expense %>
    </div>

    <div class="col-11 mb-4">
      <h5>追加した支出データ</h5>
      <h6>※再追加でデータが上書きされます</h6>

      <% if @latest_expense.present? %>
        <%= render 'registered_expense',
          expense: @latest_expense,
          accordion_id: "expensesAccordion"
        %>
      <% else %>
        <p class="text-secondary">&nbsp;&nbsp;データがありません。</p>
      <% end %>
    </div>
  </div>

  <div class="d-flex justify-content-center">
    <%= back_button('戻る', incomes_path) %>
    <% if @latest_expense.present? %>
      <%= next_button_post('保存して次へ', update_expense_data_simulation_path) %>
    <% end %>
  </div>
</div>
