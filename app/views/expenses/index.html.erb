<% content_for :title do %>Expenses<% end %>

<div class="container">
  <div class="mt-3 mb-5 text-center">
    <h1 class="display-4">Expenses</h1>
    <h4 class="mb-3">現在の月支出について教えて下さい</h4>
  </div>

  <div class="row d-flex justify-content-center">
    <div class="col-11 border border-dark rounded p-3 mb-4">
      <%= form_with model: @expense, url: create_or_update_expenses_path, local: true do |f| %>
        <div class="row d-flex justify-content-center">
          <div class="col-md-4 col-lg-3 col-xl-3">
            <%= f.label :housing_expenses, '住居費（家賃orローン）', class: 'form-label' %>
            <div class="input-group">
              <%= f.number_field :housing_expenses, class: 'form-control', step: 0.1, required: true, autofocus: true %>
              <span class="input-group-text">万円</span>
            </div>
          </div>

          <div class="col-md-4 col-lg-3 col-xl-3">
            <%= f.label :repayment_date, '住宅ローン完済時期', class: 'form-label' %>
            <div class="input-group">
              <%=
                f.select :repayment_date,
                options_for_select([['支払なし', nil]] + (Date.today.year..(Date.today.year + 50)).map { |year| [year, year] }),
                {},
                class: 'form-select'
              %>
              <span class="input-group-text">年</span>
            </div>
          </div>

          <div class="col-md-4 col-lg-3 col-xl-2">
            <%= f.label :living_expenses, '生活費', class: 'form-label' %>
            <div class="input-group">
              <%= f.number_field :living_expenses, class: 'form-control', step: 0.1, required: true %>
              <span class="input-group-text">万円</span>
            </div>
          </div>

          <div class="col-md-4 col-lg-3 col-xl-2">
            <%= f.label :monthly_premiums, '保険費（貯蓄型除く）', class: 'form-label' %>
            <div class="input-group">
              <%= f.number_field :monthly_premiums, class: 'form-control', step: 0.1, required: true %>
              <span class="input-group-text">万円</span>
            </div>
          </div>

          <div class="col-md-4 col-lg-3 col-xl-2">
            <%= f.label :other_expenses, 'その他費用', class: 'form-label' %>
            <div class="input-group">
              <%= f.number_field :other_expenses, class: 'form-control', step: 0.1, required: true %>
              <span class="input-group-text">万円</span>
            </div>
          </div>
        </div>

        <div class="mt-3 d-flex justify-content-center">
          <%= f.submit '追加', class: 'btn btn-outline-primary' %>
        </div>
      <% end %>
    </div>

    <div class="col-11 mb-4">
      <h5>追加した支出データ</h5>
      <h6>※再追加でデータが上書きされます</h6>
      <% if @latest_expense.present? %>
        <%= render 'registered_expense', expense: @latest_expense, accordion_id: "expensesAccordion" %>
      <% else %>
        <p class="text-secondary">&nbsp;&nbsp;データがありません。</p>
      <% end %>
    </div>
  </div>

  <div class="d-flex justify-content-center">
    <%= link_to '収入に戻る', incomes_path, class: 'btn btn-outline-secondary me-2', data: { turbo: true } %>
    <% if @latest_expense.present? %>
      <%= button_to '保存して次へ', update_expense_data_simulation_path, class: 'btn btn-primary', method: :post, data: { turbo: true } %>
    <% end %>
  </div>
</div>
