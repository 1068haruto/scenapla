<div id="<%= dom_id(life_event) %>" class="row">
  <p class="col">イベント種類：<%= life_event.event_type %></p>
  <p class="col">発生時期：<%= life_event.event_date %></p>
  <p class="col">タイトル：<%= life_event.title %></p>
  <p class="col">年額：<%= life_event.amount %>万円</p>
  <p class="col">支払期間：<%= life_event.payment_span %></p>
  <p class="col">
    <%= link_to '削除', life_event_path(life_event), data: { turbo_method: :delete }, class: 'btn btn-danger'%>
  </p>
</div>
