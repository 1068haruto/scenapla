<% if expense.persisted? %>
  <tr>
    <td class="px-1"><%= expense.housing_expense %>万円</td>
    <td class="px-1">
      <% if expense.repayment_date.present? %>
        <%= expense.repayment_date.year %>年
      <% else %>
        支払なし
      <% end %>
    </td>
    <td class="px-1"><%= expense.living_expenses %>万円</td>
    <td class="px-1"><%= expense.monthly_premiums %>万円</td>
    <td class="px-1"><%= expense.other_expenses %>万円</td>
  </tr>
<% end %>
