<div class="container">
  <% content_for :title do %>Edit Account<% end %>
  <div class="mb-5 text-center">
    <h1 class="display-4">Edit Account</h1>
  </div>

  <div class="row justify-content-center">
    <div class="col-10 col-md-4 border border-dark p-3 rounded">
      <h5 class="card-title mb-4 text-center">アカウント情報変更</h5>
      <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>

        <%= render "devise/shared/error_messages", resource: resource %>

        <div class="form-floating mb-3">
          <%= f.text_field :name, class: 'form-control', id: 'floatingName', autofocus: true, autocomplete: 'name', disabled: @user.sns_credentials.exists? %>
          <%= f.label :name, 'ユーザー名', class: 'form-label', for: 'floatingName' %>
        </div>

        <div class="form-floating mb-3">
          <%= f.text_field :date_of_birth, class: 'form-control', id: 'floatingBirthday', autofocus: true, placeholder: 'YYYY-MM-DD', pattern: '\d{4}-\d{2}-\d{2}' %>
          <%= f.label :date_of_birth, '生年月日', class: 'form-label', for: 'floatingBirthday' %>
          <small class="form-text text-muted">例: 1990-01-01</small>
        </div>

        <div class="form-floating mb-3">
          <%= f.email_field :email, class: 'form-control', id: 'floatingEmail', placeholder: 'name@example.com', autocomplete: 'email', disabled: @user.sns_credentials.exists? %>
          <%= f.label :email, 'メールアドレス', class: 'form-label', for: 'floatingEmail' %>
        </div>

        <% if @user.sns_credentials.exists? %>
          <div class="mb-3">
            <p class="text-center">googleアカウントと連携しています</p>
          </div>
        <% else %>
          <div class="form-floating mb-3">
            <%= f.password_field :password, class: 'form-control', id: 'floatingPassword', placeholder: 'Password', autocomplete: "new-password" %>
            <%= f.label :password, '新しいパスワード', class: 'form-label', for: 'floatingPassword' %>
          </div>

          <div class="form-floating mb-3">
            <%= f.password_field :password_confirmation, class: 'form-control', id: 'floatingPasswordConfirm', placeholder: 'Confirm Password', autocomplete: "new-password" %>
            <%= f.label :password_confirmation, '新しいパスワード(確認用)', class: 'form-label', for: 'floatingPasswordConfirm' %>
            <small class="form-text text-muted">変更する場合のみ入力</small>
          </div>
        <% end %>

        <div class="actions text-center">
          <%= f.submit "保存", class: 'btn btn-outline-primary' %>
          <%= link_to "キャンセル", user_path(@user), class: "btn btn-outline-secondary", data: { turbo: true } %>
        </div>
      <% end %>
    </div>
  </div>
</div>
