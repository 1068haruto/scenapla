<%= render layout: 'shared/input_index_layout', locals: {
  title: 'Incomes',
  subtitle: '現在の収入と退職ついて教えてください',
  description: '',
  form_content: render('income_form', income: @income),
  list_title: '追加した収入情報',
  collection: @incomes,
  acc_id: 'incomesAcc',
  back_path: dashboard_path,
  next_path: update_income_data_simulation_path
} do |income, index| %>
  <%= render 'shared/acc_item',
    model: income,
    acc_id: "incomesAcc",
    index: index,
    badge_text: income.person_type,
    badge_class: (income.person_type == '配偶者' ? 'bg-success' : 'bg-primary') do
  %>
    <table class="table table-sm table-borderless mb-0">
      <tbody>
        <tr>
          <th class="fw-bold text-secondary">月収（手取り）</th>
          <td><%= income.monthly_income %>万円</td>
        </tr>
        <tr>
          <th class="fw-bold text-secondary">賞与年額（手取り）</th>
          <td><%= income.yearly_bonus %>万円</td>
        </tr>
        <tr>
          <th class="fw-bold text-secondary">退職時期</th>
          <td><%= income.retirement_date.year %>年</td>
        </tr>
        <tr>
          <th class="fw-bold text-secondary">退職金（手取り）</th>
          <td><%= income.retirement_pay %>万円</td>
        </tr>
      </tbody>
    </table>
  <% end %>
<% end %>
