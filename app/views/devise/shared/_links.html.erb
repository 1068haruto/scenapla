<div class="text-center">
  <% if devise_mapping.recoverable? && controller_name != 'passwords' && controller_name != 'registrations' %>
    <%= link_to "パスワードをお忘れの場合", new_password_path(resource_name), class: "btn btn-link" %>
  <% end %>

  <% if devise_mapping.confirmable? && controller_name != 'confirmations' %>
    <%= link_to "確認メールを再送する場合", new_user_confirmation_path(resource_name), class: "btn btn-link" %>
  <% end %>

  <% if devise_mapping.lockable? && resource_class.unlock_strategy_enabled?(:email) && controller_name != 'unlocks' %>
    <%= link_to "アカウントのロックを解除する", new_unlock_path(resource_name), class: "btn btn-link" %>
  <% end %>

  <% if devise_mapping.omniauthable? %>
    <div class="d-flex align-items-center justify-content-center mt-3">
      <hr class="flex-grow-1">
      <span>または</span>
      <hr class="flex-grow-1">
    </div>
    <% resource_class.omniauth_providers.each do |provider| %>
      <% label = provider == :google_oauth2 ? "Google" : "#{OmniAuth::Utils.camelize(provider)}" %>
      <%= button_to omniauth_authorize_path(resource_name, provider), data: { turbo: false }, class: "btn btn-outline-primary my-2" do %>
        <% if provider == :google_oauth2 %>
          <i class="fa-brands fa-google" style="margin-right: 8px;"></i>
        <% end %>
        <%= "#{label}でログイン" %>
      <% end %>
    <% end %>
  <% end %>
</div>
