<% content_for :title do %><%= title %><% end %>

<div class="container">
  <div class="mt-3 mb-5 text-center">
    <h1 class="display-4 text-capitalize"><%= title %></h1>
    <h4 class="mb-3"><%= subtitle %></h4>
  </div>

  <div class="row d-flex justify-content-center">
    <% if local_assigns[:description] %>
      <p class="text-center"><%= description %></p>
    <% end %>

    <div class="col-11 border border-dark rounded p-3 mb-4">
      <%= form_content %>
    </div>

    <div class="col-11 mb-4">
      <h5><%= list_title %></h5>
      <% if local_assigns[:list_subtitle] %>
        <h6><%= list_subtitle %></h6>
      <% end %>

      <% if collection.present? %>
        <div class="accordion" id="<%= acc_id %>">
          <%# 単一オブジェクト と コレクション の両方に対応 %>
          <% Array(collection).each_with_index do |item, index| %>
            <%= yield item, index %>
          <% end %>
        </div>
      <% else %>
        <p class="text-secondary">&nbsp;&nbsp;データがありません。</p>
      <% end %>
    </div>
  </div>

  <div class="d-flex justify-content-center">
    <%= back_button('戻る', back_path) %>
    <% if collection.present? %>
      <%= next_button_post('保存して次へ', next_path) %>
    <% end %>
  </div>
</div>
