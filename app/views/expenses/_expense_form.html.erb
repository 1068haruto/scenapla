<%= form_with model: expense, local: true do |f| %>
  <%= render layout: 'shared/form_wrapper', locals: { f: f, model: expense, back_path: expenses_path } do %>

    <%= render layout: 'shared/form_row', locals: { f: f, field: :housing_expenses, label_text: '住居費（家賃やローン）', unit: '万円' } do %>
      <%= f.number_field :housing_expenses, class: 'form-control', step: 0.1, required: true, autofocus: true %>
    <% end %>

    <%= render layout: 'shared/form_row', locals: { f: f, field: :repayment_date, label_text: '住宅ローン完済時期', unit: '年' } do %>
      <%= f.select :repayment_date, options_for_select([['支払なし', nil]] + (Date.today.year..(Date.today.year + 50)).map { |year| [year, year] }, expense.repayment_date&.year),{}, class: 'form-select' %>
    <% end %>

    <%= render layout: 'shared/form_row', locals: { f: f, field: :living_expenses, label_text: '生活費', unit: '万円' } do %>
      <%= f.number_field :living_expenses, class: 'form-control', step: 0.1, required: true %>
    <% end %>

    <%= render layout: 'shared/form_row', locals: { f: f, field: :monthly_premiums, label_text: '保険費（貯蓄型除く）', unit: '万円' } do %>
      <%= f.number_field :monthly_premiums, class: 'form-control', step: 0.1, required: true %>
    <% end %>

    <%= render layout: 'shared/form_row', locals: { f: f, field: :other_expenses, label_text: 'その他費用', unit: '万円', last: true } do %>
      <%= f.number_field :other_expenses, class: 'form-control', step: 0.1, required: true %>
    <% end %>

  <% end %>
<% end %>