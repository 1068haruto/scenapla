<% if article %>
  <div class="accordion-item">
    <h2 class="accordion-header" id="heading-<%= accordion_id %>-<%= index %>">
      <button
        class="accordion-button collapsed d-flex align-items-start"
        type="button"
        data-bs-toggle="collapse"
        data-bs-target="#collapse-<%= accordion_id %>-<%= index %>"
        aria-expanded="false"
        aria-controls="collapse-<%= accordion_id %>-<%= index %>">

        <!-- 画像部分 -->
        <% if article['image'] %>
          <img src="<%= article['image'] %>" alt="<%= article['title'] %>" class="news-image me-3">
        <% else %>
          <img src="/placeholder-image.jpg" alt="No Image" class="news-image me-3">  <!-- 画像がない場合の代替画像 -->
        <% end %>

        <!-- テキスト部分 -->
        <div>
          <h5 class="mb-1"><%= article['title'] %></h5>
          <p class="text-muted mb-0">
            <small>提供元: <%= article['source']['name'] %> | 公開日: <%= article['publishedAt'].to_date %></small>
          </p>
        </div>
      </button>
    </h2>
    <div
      id="collapse-<%= accordion_id %>-<%= index %>"
      class="accordion-collapse collapse"
      aria-labelledby="heading-<%= accordion_id %>-<%= index %>"
      data-bs-parent="#<%= accordion_id %>">

      <div class="accordion-body">
        <p><%= article['description'] %></p>
        <a href="<%= article['url'] %>" target="_blank" class="text-primary ">記事全文を確認する</a>
      </div>
    </div>
  </div>
<% end %>
