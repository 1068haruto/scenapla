<% if life_event.persisted? %>
  <tr>
    <th scope="row" class="px-1"><%= index %></th>
    <td class="px-1"><%= life_event.event_type %></td>
    <td class="px-1"><%= life_event.event_date.year %>年</td>
    <td class="px-1"><%= life_event.title %></td>
    <td class="px-1"><%= life_event.amount %>万円</td>
    <td class="px-1"><%= life_event.payment_span %>年間</td>
    <td class="pt-1 px-1">
      <%= link_to '削除', life_event_path(life_event), class: 'btn btn-outline-danger btn-sm px-1 py-1', data: { turbo_method: :delete } %>
    </td>
  </tr>
<% end %>
