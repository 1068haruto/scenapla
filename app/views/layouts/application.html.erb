<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8">
    <title><%= content_for(:title) || "Scenapla" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="description" content="経済状態と今後のプランを可視化するツール">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= render "layouts/head/ogp" %>
    <%= render "layouts/head/analytics" %>
    <%= render "layouts/head/resources" %>
    <%= render "layouts/head/icons" %>
  </head>

  <body class="d-flex flex-column min-vh-100">
    <%= render 'layouts/header' %>

    <main class="pb-4">
      <% if user_signed_in? && current_user.date_of_birth.present? %>
        <%= render 'layouts/main/nav_tabs' %>
      <% end %>

      <!-- message -->
      <%= render 'layouts/main/alert', message: notice, type: 'success' %>
      <%= render 'layouts/main/alert', message: alert, type: 'danger' %>
      <%= render 'layouts/main/alert', message: flash.now[:error], type: 'danger' %>

      <%= yield %>
    </main>

    <%= render 'layouts/footer' %>
  </body>
</html>
