<div class="row mb-3">
  <div class="col text-center">
    <div class="card border-danger mb-2">
      <div class="card-body">
        <p class="card-text">生涯収入：<%= total_income %>万円</p>
      </div>
    </div>
  </div>
  <div class="col text-center">
    <div class="card border-info mb-2">
      <div class="card-body">
        <p class="card-text">生涯支出：<%= total_expense %>万円</p>
      </div>
    </div>
  </div>
  <div class="col text-center">
    <div class="card border-success mb-2">
      <div class="card-body">
        <p class="card-text">生涯収支：<%= total_balance %>万円</p>
      </div>
    </div>
  </div>
</div>