<% content_for :title do %>LifeEvents<% end %>

<div class="container">
  <div class="mt-3 mb-5 text-center">
    <h1 class="display-4">LifeEvents</h1>
    <h4 class="mb-3">今後のライフイベントについて教えて下さい</h4>
  </div>

  <div class="row d-flex justify-content-center">
    <p class="text-center">必ず実現したいイベントは「現実」、できれば実現したいイベントは「理想」を選択</p>
    <div class="col-11 border border-dark rounded p-3 mb-4">
      <%= render 'life_event_form', life_event: @life_event %>
    </div>

    <div class="col-11 mb-4">
      <h5>追加したライフイベントデータ</h5>
      <% if @life_events.any? %>
        <div class="accordion" id="newLifeEventsAccordion">
          <% @life_events.each_with_index do |life_event, index| %>
            <%=
              render 'registered_life_event',
              life_event: life_event,
              index: index,
              accordion_id: "newLifeEventsAccordion",
              show_delete_button: true
            %>
          <% end %>
        </div>
      <% else %>
        <p class="text-secondary">&nbsp;&nbsp;データがありません。</p>
      <% end %>
    </div>
  </div>

  <div class="d-flex justify-content-center">
    <%= link_to '資産に戻る', user_assets_path, class: 'btn btn-outline-secondary me-2', data: { turbo: true } %>
    <% if @life_events.any? %>
      <%= button_to '保存して次へ', update_life_event_data_simulation_path, class: 'btn btn-primary', method: :post, data: { turbo: true } %>
    <% end %>
  </div>
</div>
