<% content_for :title do %>Incomes<% end %>

<div class="mb-5">
  <h1>Incomes</h1>
  <h4>現在の月収入と退職ついて教えて下さい。</h4>
  <p>※金額は全てプラス値で入力</p>
</div>

<%= form_with model: @income, url: incomes_path, local: true, id: "income-form" do |f| %>
  <div class="row">
    <div class="col-md-2">
      <%= f.label :person_type, '対象者', class: 'form-label' %>
      <%= f.select :person_type, Income.person_types.keys.map { |type| [type, type] }, {}, class: 'form-select' %>
    </div>
    
    <div class="col-md-3">
      <%= f.label :income, '月収（手取り）', class: 'form-label' %>
      <div class="input-group">
        <%= f.number_field :income, class: 'form-control' %>
        <span class="input-group-text">万円</span>
      </div>
    </div>

    <div class="col-md-2">
      <%= f.label :retirement_date, '退職時期', class: 'form-label' %>
      <div class="input-group">
        <%= f.select :retirement_date, options_for_select((Date.today.year..(Date.today.year + 50)).map { |year| [year, year] }), {}, class: 'form-select' %>
        <span class="input-group-text">年</span>
      </div>
    </div>
    
    <div class="col-md-3">
      <%= f.label :retirement_pay, '退職金（手取り）', class: 'form-label' %>
      <div class="input-group">
        <%= f.number_field :retirement_pay, class: 'form-control' %>
        <span class="input-group-text">万円</span>
      </div>
    </div>
  </div>
  <div class="mb-5">
    <button type="submit" class="btn btn-primary">追加</button>
  </div>
<% end %>

<h5>追加されている収入データ</h5>
<% if @incomes.any? %>
  <% @incomes.each do |income| %>
    <%= render income %>
  <% end %>
<% else %>
  <p>データはありません</p>
<% end %>

<div class="d-flex justify-content-center">
  <%= link_to 'ホームに戻る', dashboard_path, class: 'btn btn-secondary me-2', data: { turbo: true } %>
  <% if @incomes.any? %>
    <%= button_to '保存して次へ', update_simulation_data_incomes_path(simulation_id: current_user.simulation.id), method: :post, class: 'btn btn-primary' %>
  <% end %>
</div>
