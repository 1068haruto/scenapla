<% content_for :title do %>News<% end %>

<div class="container">
  <div class="mt-3 mb-5 text-center">
    <h1 class="display-4">News</h1>
    <h4 class="mb-3">経済情報をチェック</h4>
  </div>

  <% if @news.any? %>
    <div class="accordion" id="newsAccordion">
      <% @news.each_with_index do |article, index| %>
        <%= render 'fetched_news', article: article, index: index, accordion_id: "newsAccordion" %>
      <% end %>
    </div>
  <% else %>
    <div class="alert alert-info">ニュースは見つかりませんでした。</div>
  <% end %>
</div>
