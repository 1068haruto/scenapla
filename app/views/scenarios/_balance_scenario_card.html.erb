<div class="card-header d-flex align-items-center">
  <h4 class="mt-2"><%= title %></h4>
  <% if local_assigns[:show] %>
    <span class="ms-auto"><%= formatted_date(updated_at) %>時点</span>
  <% end %>
</div>
<div class="card-body">
  <% if local_assigns[:show] %>
    <%= render 'balance_summary',
      total_income: total_income,
      total_expense: total_expense,
      total_balance: total_balance
    %>
    <%= render 'withdrawal_and_shortage',
      withdrawal: withdrawal,
      shortage: shortage
    %>
    <%= balance_chart(balance_chart_data, title) %>
  <% else %>
    <p>ライフイベント未登録のため、表示できません。</p>
  <% end %>
</div>
