<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Portfolio" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
  </head>

  <body>
    <header>
      <div class="logo">Scenapla</div>
      <div class="user-info">
        <% if current_user %>
          <span class="username"><%= "#{current_user.name}さん" %></span>
          <!-- ハンバーガーメニューの追加 -->
          <div class="hamburger-menu">
            <div class="hamburger-icon">&#9776;</div> <!-- ハンバーガーアイコン -->
            <div class="dropdown-menu">
              <%= link_to 'アカウント情報', user_path(current_user), class: 'menu-item', data: { turbo_method: :get } %>
              <%= link_to 'ログアウト', destroy_user_session_path, class: 'menu-item', data: { turbo_method: :delete } %>
            </div>
          </div>
        <% else %>
          <%= link_to 'ログイン', new_user_session_path %>
        <% end %>
      </div>
    </header>
    <% if user_signed_in? %>
      <div class="button-container">
        <%= link_to 'ホーム', dashboard_path, class: 'nav-button', data: { turbo_method: :get } %>
        <%= link_to 'シミュレーション', incomes_path, class: 'nav-button', data: { turbo_method: :get } %>
        <%= link_to 'シナリオ', scenarios_path, class: 'nav-button', data: { turbo_method: :get } %>
        <%= link_to 'ライフプラン', life_events_path, class: 'nav-button', data: { turbo_method: :get } %>
      </div>
    <% end %>

    <p class="notice"><%= notice %></p>
    <p class="alert"><%= alert %></p>

    <main>
      <%= yield %> <!-- 各ページの内容がここに挿入される -->
    </main>

    <footer>
      <button class="footer-button">お問い合わせ</button>
      <button class="footer-button">プライバシーポリシー</button>
      <button class="footer-button">利用規約</button>
      <p>&copy; <%= Time.now.year %> My Website. All rights reserved.</p>
    </footer>
  </body>
</html>
