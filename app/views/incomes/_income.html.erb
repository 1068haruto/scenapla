<% if income.persisted? %>
  <div class="row mb-2 border rounded p-2">
    <p class="col-md-2">対象者：<%= income.person_type %></p>
    <p class="col-md-2">月収 ※手取り額：<%= income.income %>万円</p>
    <p class="col-md-2">退職時期：<%= income.retirement_date.year %>年</p>
    <p class="col-md-2">退職金：<%= income.retirement_pay %>万円</p>
    <p class="col-md-2">
      <%= link_to '削除', income_path(income), data: { turbo_method: :delete }, class: 'btn btn-danger' %>
    </p>
  </div>
<% end %>